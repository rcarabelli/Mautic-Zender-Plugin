) {
    if (item && item.id) {
        mQuery('#zender_whatsapp_demo_contact_id').val(
            item.id
        );
        mQuery(field).val(item.value);
    }
};

(function () {
    'use strict';

    var root = document.getElementById('zender-whatsapp-message-manager');
    if (!root || root.getAttribute('data-segment-selector-ui-ready')) {
        return;
    }

    var destination = document.getElementById('zender-whatsapp-destination-selector');
    var segmentBlock = document.getElementById('zender-whatsapp-segment-destination');
    var campaignHelp = document.getElementById('zender-whatsapp-campaign-destination-help');
    var segmentSelector = document.getElementById('zender-whatsapp-segment-selector');
    var previewButton = document.getElementById('zender-whatsapp-segment-preview-button');

    if (!destination || !segmentBlock || !segmentSelector || !previewButton) {
        return;
    }

    root.setAttribute('data-segment-selector-ui-ready', '1');

    destination.value = {{ delivery_destination|json_encode|raw }};

    function getSelectedSegmentIds() {
        var selectedIds = Array.prototype.slice.call(
            segmentSelector.options
        ).filter(function (option) {
            return option.selected && option.value !== '';
        }).map(function (option) {
            return parseInt(option.value, 10);
        }).filter(function (segmentId) {
            return segmentId > 0;
        });

        return selectedIds.filter(function (
            segmentId,
            index,
            allIds
        ) {
            return allIds.indexOf(segmentId) === index;
        }).sort(function (left, right) {
            return left - right;
        });
    }

    function getPreviewedSegmentIds() {
        if (!enqueueButton) {
            return [];
        }

        return String(
            enqueueButton.getAttribute('data-segment-ids') || ''
        ).split(',').map(function (segmentId) {
            return parseInt(segmentId, 10);
        }).filter(function (segmentId) {
            return segmentId > 0;
        }).sort(function (left, right) {
            return left - right;
        });
    }

    function sameSegmentSelection(left, right) {
        return left.length === right.length
            && left.every(function (segmentId, index) {
                return segmentId === right[index];
            });
    }

    function syncDestination() {
        var isSegment = destination.value === 'segment';
        var selectedSegmentIds = getSelectedSegmentIds();

        segmentBlock.classList.remove('hide');
        previewButton.disabled = (
            !isSegment
            || selectedSegmentIds.length === 0
        );

        if (typeof enqueueButton !== 'undefined' && enqueueButton) {
            enqueueButton.disabled = (
                !isSegment
                || selectedSegmentIds.length === 0
                || !sameSegmentSelection(
                    selectedSegmentIds,
                    getPreviewedSegmentIds()
                )
            );
        }

        if (campaignHelp) {
            campaignHelp.classList.toggle('hide', isSegment);
        }
    }

    destination.addEventListener('change', syncDestination);
    segmentSelector.addEventListener('change', function () {
        if (getSelectedSegmentIds().length > 0) {
            destination.value = 'segment';
        }

        syncDestination();
    });

    previewButton.addEventListener('click', function () {
        var selectedSegmentIds = getSelectedSegmentIds();

        if (selectedSegmentIds.length === 0) {
            return;
        }

        var previewUrl = new URL(window.location.href);
        previewUrl.searchParams.set(
            'segment_ids',
            selectedSegmentIds.join(',')
        );
        previewUrl.searchParams.set(
            'delivery_destination',
            'segment'
        );
        previewUrl.searchParams.delete('segment_id');
        previewUrl.searchParams.delete('demo_enqueued');
        previewUrl.searchParams.delete('demo_queue_id');
        previewUrl.searchParams.delete('demo_contact_id');
        previewUrl.searchParams.delete('demo_status');

        window.location.href = previewUrl.toString();
    });

    var enqueueButton = document.getElementById(
        'zender-whatsapp-segment-enqueue-button'
    );
    var progressBox = document.getElementById(
        'zender-whatsapp-segment-enqueue-progress'
    );
    var completeBox = document.getElementById(
        'zender-whatsapp-segment-enqueue-complete'
    );
    var errorBox = document.getElementById(
        'zender-whatsapp-segment-enqueue-error'
    );
    var enqueueForm = enqueueButton
        ? enqueueButton.closest('form')
        : null;
    var segmentQueueCsrfToken = {{
        segment_queue_csrf_token|json_encode|raw
    }};
    var messageInput = enqueueForm
        ? enqueueForm.querySelector('input[name="message_id"]')
        : null;
    var enqueueEndpoint = {{ path(
        'mautic_zender_whatsapp_segment_enqueue'
    )|json_encode|raw }};
    var queueStartInput = document.getElementById(
        'zender-whatsapp-segment-queue-start'
    );
    var queueEndInput = document.getElementById(
        'zender-whatsapp-segment-queue-end'
    );
    var queueStartDateInput = document.getElementById(
        'zender-whatsapp-segment-queue-start-date'
    );
    var queueStartTimeInput = document.getElementById(
        'zender-whatsapp-segment-queue-start-time'
    );
    var queueEndDateInput = document.getElementById(
        'zender-whatsapp-segment-queue-end-date'
    );
    var queueEndTimeInput = document.getElementById(
        'zender-whatsapp-segment-queue-end-time'
    );

    function padQueueDatePart(value) {
        return String(value).padStart(2, '0');
    }

    function localQueueDateValue(date) {
        return date.getFullYear()
            + '-' + padQueueDatePart(date.getMonth() + 1)
            + '-' + padQueueDatePart(date.getDate());
    }

    function localQueueTimeValue(date) {
        return padQueueDatePart(date.getHours())
            + ':' + padQueueDatePart(date.getMinutes());
    }

    function combineQueueDateTime(dateInput, timeInput) {
        if (
            !dateInput
            || !timeInput
            || !dateInput.value
            || !timeInput.value
        ) {
            return '';
        }

        return dateInput.value + 'T' + timeInput.value;
    }

    function syncQueueScheduleInputs() {
        if (queueStartInput) {
            queueStartInput.value = combineQueueDateTime(
                queueStartDateInput,
                queueStartTimeInput
            );
        }

        if (queueEndInput) {
            queueEndInput.value = combineQueueDateTime(
                queueEndDateInput,
                queueEndTimeInput
            );
        }
    }

    function initializeQueueSchedule() {
        if (
            !queueStartInput
            || !queueStartDateInput
            || !queueStartTimeInput
        ) {
            return;
        }

        var now = new Date();
        now.setSeconds(0, 0);

        if (!queueStartDateInput.value) {
            queueStartDateInput.value = localQueueDateValue(now);
        }

        if (!queueStartTimeInput.value) {
            queueStartTimeInput.value = localQueueTimeValue(now);
        }

        queueStartDateInput.min = localQueueDateValue(now);

        if (queueEndDateInput) {
            queueEndDateInput.min = queueStartDateInput.value;
        }

        syncQueueScheduleInputs();
    }

    function readQueueSchedule() {
        syncQueueScheduleInputs();

        if (!queueStartInput || !queueStartInput.value) {
            return null;
        }

        var availableAt = new Date(queueStartInput.value);

        if (Number.isNaN(availableAt.getTime())) {
            return null;
        }

        var endHasDate = Boolean(
            queueEndDateInput && queueEndDateInput.value
        );
        var endHasTime = Boolean(
            queueEndTimeInput && queueEndTimeInput.value
        );

        if (endHasDate !== endHasTime) {
            return null;
        }

        var expiresAt = null;

        if (queueEndInput && queueEndInput.value) {
            expiresAt = new Date(queueEndInput.value);

            if (
                Number.isNaN(expiresAt.getTime())
                || expiresAt <= availableAt
            ) {
                return null;
            }
        }

        return {
            available_at: availableAt.toISOString(),
            expires_at: expiresAt
                ? expiresAt.toISOString()
                : ''
        };
    }

    function sameQueueSchedule(state, schedule) {
        return state
            && state.available_at === schedule.available_at
            && state.expires_at === schedule.expires_at;
    }

    initializeQueueSchedule();

    [
        queueStartDateInput,
        queueStartTimeInput,
        queueEndDateInput,
        queueEndTimeInput
    ].forEach(function (input) {
        if (!input) {
            return;
        }

        input.addEventListener('change', function () {
            if (queueEndDateInput && queueStartDateInput) {
                queueEndDateInput.min = queueStartDateInput.value;
            }

            syncQueueScheduleInputs();
        });
    });

    function showBox(box, text) {
        if (!box) {
            return;
        }

        box.textContent = text;
        box.classList.remove('hide');
    }

    function hideBox(box) {
        if (box) {
            box.classList.add('hide');
        }
    }

    function emptyTotals() {
        return {
            scanned: 0,
            eligible: 0,
            enqueued: 0,
            rejected: 0
        };
    }

    function createOperationId() {
        var bytes = new Uint8Array(16);

        if (
            window.crypto
            && typeof window.crypto.getRandomValues === 'function'
        ) {
            window.crypto.getRandomValues(bytes);

            return Array.prototype.map.call(
                bytes,
                function (byte) {
                    return ('0' + byte.toString(16)).slice(-2);
                }
            ).join('');
        }

        var fallback = '';

        for (var index = 0; index < 32; index += 1) {
            fallback += Math.floor(Math.random() * 16).toString(16);
        }

        return fallback;
    }

    function storageKey(messageId, segmentIds) {
        var normalizedSelection = segmentIds
            .slice()
            .sort(function (left, right) {
                return left - right;
            })
            .join('-');

        return 'zender-segment-broadcast:'
            + messageId
            + ':'
            + normalizedSelection;
    }

    function loadState(key) {
        try {
            var value = window.localStorage.getItem(key);

            if (!value) {
                return null;
            }

            var state = JSON.parse(value);

            if (
                !state
                || typeof state !== 'object'
                || typeof state.operation_id !== 'string'
                || (
                    state.operation_id !== ''
                    && !/^[a-f0-9]{32}$/.test(state.operation_id)
                )
                || typeof state.after_contact_id !== 'number'
                || typeof state.totals !== 'object'
                || typeof state.available_at !== 'string'
                || typeof state.expires_at !== 'string'
            ) {
                return null;
            }

            return state;
        } catch (error) {
            return null;
        }
    }

    function saveState(key, state) {
        try {
            window.localStorage.setItem(
                key,
                JSON.stringify(state)
            );
        } catch (error) {
            // Queueing remains valid even if local persistence is unavailable.
        }
    }

    function clearState(key) {
        try {
            window.localStorage.removeItem(key);
        } catch (error) {
            // Completion does not depend on local persistence.
        }
    }

    function progressText(totals) {
        return {{ 'mautic.zender.whatsapp.messages.segment_send.progress'|trans({
            '%scanned%': '__SCANNED__',
            '%eligible%': '__ELIGIBLE__',
            '%enqueued%': '__ENQUEUED__'
        })|json_encode|raw }}
            .replace('__SCANNED__', String(totals.scanned))
            .replace('__ELIGIBLE__', String(totals.eligible))
            .replace('__ENQUEUED__', String(totals.enqueued));
    }

    function localScheduleDisplay(value) {
        if (!value) {
            return '—';
        }

        var date = new Date(value);

        return Number.isNaN(date.getTime())
            ? '—'
            : date.toLocaleString();
    }

    function completeText(totals, state) {
        var message = {{ 'mautic.zender.whatsapp.messages.segment_send.complete'|trans({
            '%enqueued%': '__ENQUEUED__',
            '%rejected%': '__REJECTED__'
        })|json_encode|raw }}
            .replace('__ENQUEUED__', String(totals.enqueued))
            .replace('__REJECTED__', String(totals.rejected));

        return message
            + ' '
            + {{ 'mautic.zender.whatsapp.messages.segment_schedule.start'|trans|json_encode|raw }}
            + ': '
            + localScheduleDisplay(state.available_at)
            + '. '
            + {{ 'mautic.zender.whatsapp.messages.segment_schedule.end'|trans|json_encode|raw }}
            + ': '
            + localScheduleDisplay(state.expires_at)
            + '.';
    }

    async function enqueueNextBatch(
        endpoint,
        token,
        messageId,
        segmentIds,
        key,
        state
    ) {
        var formData = new FormData();
        formData.set('_token', token);
        formData.set(
            'delivery_action',
            'segment_enqueue_batch'
        );
        formData.set('message_id', String(messageId));
        formData.set('segment_ids', segmentIds.join(','));
        formData.set(
            'operation_id',
            state.operation_id || ''
        );
        formData.set(
            'after_contact_id',
            String(state.after_contact_id || 0)
        );
        formData.set(
            'available_at',
            state.available_at
        );
        formData.set(
            'expires_at',
            state.expires_at
        );

        var response = await window.fetch(endpoint, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Accept': 'application/json'
            },
            body: formData
        });

        var responseText = await response.text();
        var payload = null;

        try {
            payload = responseText !== ''
                ? JSON.parse(responseText)
                : null;
        } catch (parseError) {
            throw new Error(
                'http_'
                + String(response.status)
                + '_invalid_json'
            );
        }

        if (!response.ok || !payload || !payload.ok) {
            throw new Error(
                payload && payload.reason
                    ? String(payload.reason)
                    : 'http_' + String(response.status)
            );
        }

        state.operation_id = payload.operation_id;
        state.after_contact_id = payload.next_contact_id;
        state.totals.scanned += payload.scanned_count;
        state.totals.eligible += payload.eligible_count;
        state.totals.enqueued += payload.enqueued_count;
        state.totals.rejected += (
            payload.enqueue_rejected_count
        );

        saveState(key, state);
        showBox(progressBox, progressText(state.totals));

        if (payload.has_more) {
            return enqueueNextBatch(
                endpoint,
                token,
                messageId,
                segmentIds,
                key,
                state
            );
        }

        clearState(key);
        hideBox(progressBox);
        showBox(completeBox, completeText(state.totals, state));

        return state;
    }

    if (enqueueButton) {
        enqueueButton.addEventListener('click', async function () {
            var selectedSegmentIds = getSelectedSegmentIds();
            var messageId = messageInput
                ? parseInt(messageInput.value, 10)
                : 0;
            var token = segmentQueueCsrfToken || '';
            var schedule = readQueueSchedule();

            if (!schedule) {
                showBox(
                    errorBox,
                    {{ 'mautic.zender.whatsapp.messages.segment_schedule.invalid'|trans|json_encode|raw }}
                );

                return;
            }

            if (
                selectedSegmentIds.length === 0
                || !messageId
                || !token
                || !window.confirm(
                    enqueueButton.getAttribute('data-confirm')
                )
            ) {
                return;
            }

            enqueueButton.disabled = true;
            hideBox(completeBox);
            hideBox(errorBox);

            var key = storageKey(
                messageId,
                selectedSegmentIds
            );
            var state = loadState(key);

            if (
                state
                && !sameQueueSchedule(state, schedule)
            ) {
                clearState(key);
                state = null;
            }

            state = state || {
                operation_id: createOperationId(),
                after_contact_id: 0,
                totals: emptyTotals(),
                available_at: schedule.available_at,
                expires_at: schedule.expires_at
            };

            if (!state.operation_id) {
                state.operation_id = createOperationId();
            }

            saveState(key, state);
            showBox(progressBox, progressText(state.totals));

            try {
                await enqueueNextBatch(
                    enqueueEndpoint,
                    token,
                    messageId,
                    selectedSegmentIds,
                    key,
                    state
                );
            } catch (error) {
                var errorReason = (
                    error
                    && typeof error.message === 'string'
                    && error.message !== ''
                ) ? error.message : 'enqueue_failed';

                if (window.console && window.console.error) {
                    window.console.error(
                        'Zender segment queue preparation failed:',
                        error
                    );
                }

                showBox(
                    errorBox,
                    {{ 'mautic.zender.whatsapp.messages.segment_send.error'|trans|json_encode|raw }}
                    + ' [' + errorReason + ']'
                );
            } finally {
                syncDestination();
            }
        });
    }

    syncDestination();
})();

(function () {
    'use strict';

    var root = document.getElementById('zender-whatsapp-message-manager');

    if (!root || root.getAttribute('data-contact-token-editor-ready')) {
        return;
    }

    root.setAttribute('data-contact-token-editor-ready', '1');

    var textarea = document.getElementById('zender-whatsapp-message-content');
    var customAlias = document.getElementById(
        'zender-whatsapp-custom-token-alias'
    );
    var customButton = document.getElementById(
        'zender-whatsapp-insert-custom-token'
    );
    var error = document.getElementById('zender-whatsapp-token-error');

    function insertToken(token) {
        if (!textarea || !token) {
            return;
        }

        var start = textarea.selectionStart;
        var end = textarea.selectionEnd;
        var value = textarea.value;
        var prefix = start > 0 && !/\s$/.test(value.slice(0, start)) ? ' ' : '';
        var suffix = end < value.length && !/^\s/.test(value.slice(end)) ? ' ' : '';
        var inserted = prefix + token + suffix;

        textarea.value = value.slice(0, start) + inserted + value.slice(end);
        textarea.focus();

        var cursor = start + inserted.length;
        textarea.setSelectionRange(cursor, cursor);
        textarea.dispatchEvent(new Event('input', {bubbles: true}));
    }

    root.addEventListener('click', function (event) {
        var button = event.target.closest(
            '[data-whatsapp-contact-token]'
        );

        if (!button || !root.contains(button)) {
            return;
        }

        event.preventDefault();
        insertToken(button.getAttribute('data-whatsapp-contact-token'));
    });

    if (customButton) {
        customButton.addEventListener('click', function (event) {
            event.preventDefault();

            var alias = customAlias ? customAlias.value.trim() : '';
            var valid = /^[A-Za-z0-9_]+$/.test(alias);

            if (error) {
                error.classList.toggle('hide', valid);
            }

            if (!valid) {
                if (customAlias) {
                    customAlias.focus();
                }

                return;
            }

            insertToken('{contactfield=' + alias + '}');
            customAlias.value = '';
        });
    }
})();
</script>
{% endblock %}
