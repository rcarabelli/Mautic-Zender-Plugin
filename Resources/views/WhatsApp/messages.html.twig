                                            'zender-whatsapp-ai-spintax-result-panel'
                                        );
                                        var resultField = document.getElementById(
                                            'zender-whatsapp-ai-spintax-result'
                                        );
                                        var providerBox = document.getElementById(
                                            'zender-whatsapp-ai-spintax-provider'
                                        );
                                        var debugPanel = document.getElementById(
                                            'zender-whatsapp-ai-spintax-debug-panel'
                                        );
                                        var debugLog = document.getElementById(
                                            'zender-whatsapp-ai-spintax-debug-log'
                                        );
                                        var debugCopy = document.getElementById(
                                            'zender-whatsapp-ai-spintax-debug-copy'
                                        );

                                        if (!button || !checkbox) {
                                            return;
                                        }

                                        if (debugPanel) {
                                            debugPanel.remove();
                                        }

                                        debugPanel = null;
                                        debugLog = null;
                                        debugCopy = null;

                                        function render(record) {
                                            return;
                                        }

                                        function showStatus(message, type) {
                                            if (!statusBox) {
                                                return;
                                            }

                                            statusBox.className = 'alert mt-md alert-' + type;
                                            statusBox.textContent = message;
                                            statusBox.style.display = '';
                                        }

                                        function readSource() {
                                            if (!sourceField) {
                                                return '';
                                            }

                                            if (
                                                window.CKEDITOR
                                                && sourceField.id
                                                && window.CKEDITOR.instances
                                                && window.CKEDITOR.instances[sourceField.id]
                                            ) {
                                                return window.CKEDITOR.instances[
                                                    sourceField.id
                                                ].getData();
                                            }

                                            if (
                                                window.tinymce
                                                && sourceField.id
                                                && window.tinymce.get(sourceField.id)
                                            ) {
                                                return window.tinymce.get(
                                                    sourceField.id
                                                ).getContent();
                                            }

                                            return sourceField.value || '';
                                        }

                                        function syncButton() {
                                            button.disabled = !checkbox.checked;
                                        }

                                        checkbox.addEventListener('change', syncButton);
                                        syncButton();

                                        if (debugCopy) {
                                            debugCopy.addEventListener(
                                                'click',
                                                function () {
                                                    if (!debugLog) {
                                                        return;
                                                    }

                                                    if (
                                                        navigator.clipboard
                                                        && navigator.clipboard.writeText
                                                    ) {
                                                        navigator.clipboard.writeText(
                                                            debugLog.value || ''
                                                        );
                                                    } else {
                                                        debugLog.focus();
                                                        debugLog.select();
                                                        document.execCommand('copy');
                                                    }
                                                }
                                            );
                                        }

                                        button.addEventListener(
                                            'click',
                                            async function (event) {
                                                event.preventDefault();
                                                event.stopImmediatePropagation();

                                                var source = readSource().trim();
                                                var requestUrl = {{ path('mautic_zender_whatsapp_spintax_generate')|json_encode|raw }};
                                                var formData = new FormData();

                                                formData.set(
                                                    '_token',
                                                    {{ csrf_token|json_encode|raw }}
                                                );
                                                formData.set('source_text', source);
                                                formData.set(
                                                    'style',
                                                    (
                                                        document.getElementById(
                                                            'zender-whatsapp-ai-spintax-style'
                                                        ) || {}
                                                    ).value || 'mixed'
                                                );
                                                formData.set(
                                                    'level',
                                                    (
                                                        document.getElementById(
                                                            'zender-whatsapp-ai-spintax-level'
                                                        ) || {}
                                                    ).value || 'minimum_3x3'
                                                );
                                                formData.set(
                                                    'minimum_blocks',
                                                    (
                                                        document.getElementById(
                                                            'zender-whatsapp-ai-spintax-min-blocks'
                                                        ) || {}
                                                    ).value || '3'
                                                );
                                                formData.set(
                                                    'minimum_options',
                                                    (
                                                        document.getElementById(
                                                            'zender-whatsapp-ai-spintax-min-options'
                                                        ) || {}
                                                    ).value || '3'
                                                );

                                                var safeFormData = {};
                                                formData.forEach(function (value, key) {
                                                    safeFormData[key] = (
                                                        '_token' === key
                                                        ? '[REDACTED_PRESENT]'
                                                        : String(value)
                                                    );
                                                });

                                                var record = {
                                                    generated_at_utc: new Date().toISOString(),
                                                    request: {
                                                        target_url: requestUrl,
                                                        method: 'POST',
                                                        credentials: 'same-origin',
                                                        form_data: safeFormData
                                                    },
                                                    response: null,
                                                    javascript_error: null
                                                };

                                                render(record);

                                                if (!source) {
                                                    record.javascript_error = {
                                                        message: 'source_message_empty'
                                                    };
                                                    render(record);
                                                    showStatus(
                                                        'Source message is empty.',
                                                        'warning'
                                                    );
                                                    return;
                                                }

                                                button.disabled = true;
                                                showStatus(
                                                    'Generating spintax version…',
                                                    'info'
                                                );

                                                try {
                                                    var response = await window.fetch(
                                                        requestUrl,
                                                        {
                                                            method: 'POST',
                                                            credentials: 'same-origin',
                                                            body: formData
                                                        }
                                                    );

                                                    var rawBody = await response.text();
                                                    var payload = null;

                                                    try {
                                                        payload = JSON.parse(rawBody);
                                                    } catch (parseError) {
                                                        record.javascript_error = {
                                                            message: 'invalid_json_response',
                                                            detail: String(
                                                                parseError.message || ''
                                                            )
                                                        };
                                                    }

                                                    record.response = {
                                                        ok: response.ok,
                                                        status: response.status,
                                                        final_url: response.url,
                                                        raw_body: rawBody,
                                                        parsed_json: payload
                                                    };

                                                    render(record);

                                                    if (
                                                        !response.ok
                                                        || !payload
                                                        || !payload.ok
                                                        || !payload.generated_text
                                                    ) {
                                                        throw new Error(
                                                            (
                                                                payload
                                                                && (
                                                                    payload.reason
                                                                    || payload.error
                                                                )
                                                            )
                                                            || 'generation_failed'
                                                        );
                                                    }

                                                    if (resultField) {
                                                        resultField.value = payload.generated_text;
                                                    }

                                                    if (providerBox) {
                                                        providerBox.textContent = (
                                                            'Provider / Proveedor: '
                                                            + (payload.provider || '')
                                                            + (
                                                                payload.model
                                                                ? ' / ' + payload.model
                                                                : ''
                                                            )
                                                        );
                                                    }

                                                    if (resultPanel) {
                                                        resultPanel.style.display = '';
                                                    }

                                                    showStatus(
                                                        'Spintax version generated.',
                                                        'success'
                                                    );
                                                } catch (error) {
                                                    record.javascript_error = {
                                                        message: String(
                                                            error.message
                                                            || 'generation_failed'
                                                        ),
                                                        stack: error.stack
                                                            ? String(error.stack)
                                                            : null
                                                    };
                                                    render(record);
                                                    showStatus(
                                                        'Spintax generation failed: '
                                                        + record.javascript_error.message,
                                                        'danger'
                                                    );
                                                } finally {
                                                    syncButton();
                                                }
                                            },
                                            true
                                        );
                                    }

                                    if ('loading' === document.readyState) {
                                        document.addEventListener(
                                            'DOMContentLoaded',
                                            start
                                        );
                                    } else {
                                        start();
                                    }
                                }());
                                </script>
