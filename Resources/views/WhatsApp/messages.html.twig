                                <script>
                                (function () {
                                    'use strict';

                                    var checkbox = document.getElementById(
                                        'zender-whatsapp-ai-spintax-enabled'
                                    );
                                    var generateButton = document.getElementById(
                                        'zender-whatsapp-ai-spintax-generate'
                                    );
                                    var replaceButton = document.getElementById(
                                        'zender-whatsapp-ai-spintax-replace'
                                    );
                                    var resultPanel = document.getElementById(
                                        'zender-whatsapp-ai-spintax-result-panel'
                                    );
                                    var resultField = document.getElementById(
                                        'zender-whatsapp-ai-spintax-result'
                                    );
                                    var statusBox = document.getElementById(
                                        'zender-whatsapp-ai-spintax-status'
                                    );
                                    var providerBox = document.getElementById(
                                        'zender-whatsapp-ai-spintax-provider'
                                    );
                                    var debugPanel = document.getElementById(
                                        'zender-whatsapp-ai-spintax-debug-panel'
                                    );
                                    var debugLog = document.getElementById(
                                        'zender-whatsapp-ai-spintax-debug-log'
                                    );
                                    var debugCopyButton = document.getElementById(
                                        'zender-whatsapp-ai-spintax-debug-copy'
                                    );
                                    var styleField = document.getElementById(
                                        'zender-whatsapp-ai-spintax-style'
                                    );
                                    var levelField = document.getElementById(
                                        'zender-whatsapp-ai-spintax-level'
                                    );
                                    var minimumBlocksField = document.getElementById(
                                        'zender-whatsapp-ai-spintax-min-blocks'
                                    );
                                    var minimumOptionsField = document.getElementById(
                                        'zender-whatsapp-ai-spintax-min-options'
                                    );

                                    var labels = {
                                        generating: {{ 'mautic.zender.whatsapp.messages.spintax.generating'|trans|json_encode|raw }},
                                        success: {{ 'mautic.zender.whatsapp.messages.spintax.success'|trans|json_encode|raw }},
                                        error: {{ 'mautic.zender.whatsapp.messages.spintax.error'|trans|json_encode|raw }},
                                        missingSource: {{ 'mautic.zender.whatsapp.messages.spintax.missing_source'|trans|json_encode|raw }},
                                        provider: {{ 'mautic.zender.whatsapp.messages.spintax.provider'|trans|json_encode|raw }},
                                        replaced: {{ 'mautic.zender.whatsapp.messages.spintax.replaced'|trans|json_encode|raw }}
                                    };

                                    function findSourceField() {
                                        var selectors = [
                                            '#zender-whatsapp-message-content',
                                            'textarea[name="content"]',
                                            'textarea[name="message"]',
                                            'textarea[name="message_content"]',
                                            'textarea[name="message[content]"]',
                                            'textarea[name$="[content]"]'
                                        ];

                                        for (
                                            var index = 0;
                                            index < selectors.length;
                                            index++
                                        ) {
                                            var field = document.querySelector(
                                                selectors[index]
                                            );

                                            if (
                                                field
                                                && field !== resultField
                                            ) {
                                                return field;
                                            }
                                        }

                                        var textareas = document.querySelectorAll(
                                            'textarea'
                                        );

                                        for (
                                            var offset = 0;
                                            offset < textareas.length;
                                            offset++
                                        ) {
                                            if (
                                                textareas[offset] !== resultField
                                                && !textareas[offset].closest(
                                                    '#zender-whatsapp-ai-spintax-controls'
                                                )
                                            ) {
                                                return textareas[offset];
                                            }
                                        }

                                        return null;
                                    }

                                    function readSource(field) {
                                        if (!field) {
                                            return '';
                                        }

                                        if (
                                            window.CKEDITOR
                                            && field.id
                                            && window.CKEDITOR.instances
                                            && window.CKEDITOR.instances[field.id]
                                        ) {
                                            return window.CKEDITOR.instances[
                                                field.id
                                            ].getData();
                                        }

                                        if (
                                            window.tinymce
                                            && field.id
                                            && window.tinymce.get(field.id)
                                        ) {
                                            return window.tinymce.get(
                                                field.id
                                            ).getContent();
                                        }

                                        return field.value || '';
                                    }

                                    function writeSource(field, value) {
                                        if (!field) {
                                            return false;
                                        }

                                        field.value = value;

                                        if (
                                            window.CKEDITOR
                                            && field.id
                                            && window.CKEDITOR.instances
                                            && window.CKEDITOR.instances[field.id]
                                        ) {
                                            window.CKEDITOR.instances[
                                                field.id
                                            ].setData(value);
                                        }

                                        if (
                                            window.tinymce
                                            && field.id
                                            && window.tinymce.get(field.id)
                                        ) {
                                            window.tinymce.get(
                                                field.id
                                            ).setContent(value);
                                        }

                                        field.dispatchEvent(
                                            new Event('input', {
                                                bubbles: true
                                            })
                                        );
                                        field.dispatchEvent(
                                            new Event('change', {
                                                bubbles: true
                                            })
                                        );

                                        return true;
                                    }

                                    function messageForm() {
                                        return generateButton.closest(
                                            'form'
                                        );
                                    }

                                    function csrfToken() {
                                        var form = messageForm();
                                        var input = form
                                            ? form.querySelector(
                                                'input[name="_token"]'
                                            )
                                            : null;

                                        if (!input) {
                                            input = document.querySelector(
                                                'input[name="_token"]'
                                            );
                                        }

                                        return input ? input.value : '';
                                    }

                                    function sanitizeDebugText(value) {
                                        return String(value || '')
                                            .replace(/\b(?:sk|xai)-[A-Za-z0-9_-]{8,}\b/g, '[REDACTED_API_KEY]')
                                            .replace(/Bearer\s+[A-Za-z0-9._-]{8,}/gi, 'Bearer [REDACTED]')
                                            .replace(/(<input[^>]+name=["']_token["'][^>]+value=["'])[^"']+(["'])/gi, '$1[REDACTED_CSRF]$2');
                                    }

                                    function serializeDebugValue(value) {
                                        if (window.File && value instanceof window.File) {
                                            return {
                                                type: 'File',
                                                name: value.name,
                                                size: value.size,
                                                mime_type: value.type,
                                                last_modified: value.lastModified
                                            };
                                        }
                                        return sanitizeDebugText(value);
                                    }

                                    function serializeFormData(formData) {
                                        var values = {};
                                        formData.forEach(function (value, key) {
                                            var safeValue = key === '_token'
                                                ? (value ? '[REDACTED_PRESENT]' : '[MISSING]')
                                                : serializeDebugValue(value);
                                            if (Object.prototype.hasOwnProperty.call(values, key)) {
                                                if (!Array.isArray(values[key])) {
                                                    values[key] = [values[key]];
                                                }
                                                values[key].push(safeValue);
                                            } else {
                                                values[key] = safeValue;
                                            }
                                        });
                                        return values;
                                    }

                                    function serializeResponseHeaders(headers) {
                                        var values = {};
                                        headers.forEach(function (value, key) {
                                            values[key] = sanitizeDebugText(value);
                                        });
                                        return values;
                                    }

                                    function serializeError(error) {
                                        return {
                                            name: error && error.name ? String(error.name) : 'Error',
                                            message: error && error.message ? sanitizeDebugText(error.message) : 'Unknown JavaScript error',
                                            stack: error && error.stack ? sanitizeDebugText(error.stack) : null
                                        };
                                    }

                                    function renderDebug(record) {
                                        debugPanel.style.display = '';
                                        debugLog.value = JSON.stringify(record, null, 2);
                                    }

                                    function showStatus(message, type) {
                                        statusBox.className = (
                                            'alert mt-md alert-' + type
                                        );
                                        statusBox.textContent = message;
                                        statusBox.style.display = '';
                                    }

                                    function syncGenerateButton() {
                                        var source = readSource(
                                            findSourceField()
                                        ).trim();

                                        generateButton.disabled = !(
                                            checkbox
                                            && checkbox.checked
                                            && source.length > 0
                                        );
                                    }

                                    if (checkbox) {
                                        checkbox.addEventListener(
                                            'change',
                                            syncGenerateButton
                                        );
                                    }

                                    document.addEventListener(
                                        'input',
                                        function (event) {
                                            if (
                                                event.target
                                                && event.target !== resultField
                                            ) {
                                                syncGenerateButton();
                                            }
                                        }
                                    );

                                    debugCopyButton.addEventListener(
                                        'click',
                                        async function () {
                                            var value = debugLog.value || '';
                                            if (!value) {
                                                return;
                                            }
                                            try {
                                                await navigator.clipboard.writeText(value);
                                            } catch (copyError) {
                                                debugLog.focus();
                                                debugLog.select();
                                                document.execCommand('copy');
                                            }
                                        }
                                    );

                                    generateButton.addEventListener(
                                        'click',
                                        async function () {
                                            var source = readSource(
                                                findSourceField()
                                            ).trim();

                                            if (!source) {
                                                showStatus(
                                                    labels.missingSource,
                                                    'warning'
                                                );
                                                return;
                                            }

                                            var formData = new FormData();
                                            formData.set(
                                                '_token',
                                                csrfToken()
                                            );
                                            formData.set(
                                                'delivery_action',
                                                'ai_spintax_generate'
                                            );
                                            formData.set(
                                                'source_text',
                                                source
                                            );
                                            formData.set(
                                                'style',
                                                styleField
                                                    ? styleField.value
                                                    : 'mixed'
                                            );
                                            formData.set(
                                                'level',
                                                levelField
                                                    ? levelField.value
                                                    : 'minimum_3x3'
                                            );
                                            formData.set(
                                                'minimum_blocks',
                                                minimumBlocksField
                                                    ? minimumBlocksField.value
                                                    : '3'
                                            );
                                            formData.set(
                                                'minimum_options',
                                                minimumOptionsField
                                                    ? minimumOptionsField.value
                                                    : '3'
                                            );

                                            generateButton.disabled = true;
                                            showStatus(
                                                labels.generating,
                                                'info'
                                            );

                                            try {
                                                {# AI_SPINTAX_FORM_ACTION_TARGET_BEGIN #}
                                                var form = messageForm();
                                                var requestUrl = (
                                                    form
                                                    && form.action
                                                    ? form.action
                                                    : window.location.href
                                                );

                                                var requestHeaders = {
                                                    'X-Requested-With': 'XMLHttpRequest',
                                                    'Accept': 'application/json'
                                                };
                                                var debugRecord = {
                                                    generated_at_utc: new Date().toISOString(),
                                                    request: {
                                                        current_page_url: window.location.href,
                                                        target_url: requestUrl,
                                                        form_action: form && form.action ? form.action : null,
                                                        method: 'POST',
                                                        credentials: 'same-origin',
                                                        headers: requestHeaders,
                                                        form_data: serializeFormData(formData)
                                                    },
                                                    response: null,
                                                    javascript_error: null
                                                };
                                                var requestStartedAt = window.performance && window.performance.now
                                                    ? window.performance.now()
                                                    : Date.now();

                                                renderDebug(debugRecord);

                                                var response = await window.fetch(
                                                    requestUrl,
                                                    {
                                                        method: 'POST',
                                                        credentials: 'same-origin',
                                                        headers: requestHeaders,
                                                        body: formData
                                                    }
                                                );
                                                {# AI_SPINTAX_FORM_ACTION_TARGET_END #}

                                                var rawBody = await response.text();
                                                var requestFinishedAt = window.performance && window.performance.now
                                                    ? window.performance.now()
                                                    : Date.now();
                                                var payload = null;
                                                var jsonParseError = null;

                                                try {
                                                    payload = JSON.parse(rawBody);
                                                } catch (parseError) {
                                                    jsonParseError = serializeError(parseError);
                                                }

                                                debugRecord.response = {
                                                    ok: response.ok,
                                                    status: response.status,
                                                    status_text: response.statusText,
                                                    type: response.type,
                                                    redirected: response.redirected,
                                                    final_url: response.url,
                                                    duration_ms: Math.round(requestFinishedAt - requestStartedAt),
                                                    headers: serializeResponseHeaders(response.headers),
                                                    raw_body: sanitizeDebugText(rawBody),
                                                    parsed_json: payload,
                                                    json_parse_error: jsonParseError
                                                };
                                                renderDebug(debugRecord);

                                                if (jsonParseError) {
                                                    throw new Error('invalid_json_response');
                                                }

                                                if (
                                                    !response.ok
                                                    || !payload.ok
                                                    || !payload.generated_text
                                                ) {
                                                    throw new Error(
                                                        payload.reason
                                                        || 'generation_failed'
                                                    );
                                                }

                                                resultField.value = (
                                                    payload.generated_text
                                                );
                                                providerBox.textContent = (
                                                    labels.provider
                                                    + ': '
                                                    + (
                                                        payload.provider
                                                        || ''
                                                    )
                                                    + (
                                                        payload.model
                                                        ? ' / ' + payload.model
                                                        : ''
                                                    )
                                                );
                                                resultPanel.style.display = '';
                                                showStatus(
                                                    labels.success,
                                                    'success'
                                                );
                                            } catch (error) {
                                                if (typeof debugRecord !== 'undefined' && debugRecord) {
                                                    debugRecord.javascript_error = serializeError(error);
                                                    renderDebug(debugRecord);
                                                } else {
                                                    renderDebug({
                                                        generated_at_utc: new Date().toISOString(),
                                                        request: null,
                                                        response: null,
                                                        javascript_error: serializeError(error)
                                                    });
                                                }

                                                {# AI_SPINTAX_EXACT_REASON_DISPLAY_BEGIN #}
                                                var failureReason = (
                                                    error
                                                    && error.message
                                                    ? String(error.message)
                                                    : 'generation_failed'
                                                )
                                                    .replace(
                                                        /[^a-zA-Z0-9_.:-]/g,
                                                        '_'
                                                    )
                                                    .slice(0, 120);

                                                showStatus(
                                                    labels.error
                                                    + ' ['
                                                    + failureReason
                                                    + ']',
                                                    'danger'
                                                );
                                                {# AI_SPINTAX_EXACT_REASON_DISPLAY_END #}
                                            } finally {
                                                syncGenerateButton();
                                            }
                                        }
                                    );

                                    replaceButton.addEventListener(
                                        'click',
                                        function () {
                                            var reviewed = (
                                                resultField.value || ''
                                            ).trim();

                                            if (!reviewed) {
                                                return;
                                            }

                                            if (
                                                writeSource(
                                                    findSourceField(),
                                                    reviewed
                                                )
                                            ) {
                                                showStatus(
                                                    labels.replaced,
                                                    'success'
                                                );
                                            }
                                        }
                                    );

                                    syncGenerateButton();
                                    window.setTimeout(
                                        syncGenerateButton,
                                        500
                                    );
                                    window.setTimeout(
                                        syncGenerateButton,
                                        1500
                                    );
                                }());
                                </script>

                                {# AI_SPINTAX_BROWSER_RESCUE_BEGIN #}
                                <script>
                                (function () {
                                    'use strict';

                                    function start() {
                                        var checkbox = document.getElementById(
                                            'zender-whatsapp-ai-spintax-enabled'
                                        );
                                        var button = document.getElementById(
                                            'zender-whatsapp-ai-spintax-generate'
                                        );
