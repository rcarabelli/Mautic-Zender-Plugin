<script>
(function () {
    'use strict';

    function startQueueCancelControl() {
        var button = document.getElementById(
            'zender-whatsapp-segment-cancel-button'
        );
        var status = document.getElementById(
            'zender-whatsapp-segment-cancel-status'
        );

        if (!button || button.getAttribute('data-cancel-ready')) {
            return;
        }

        button.setAttribute('data-cancel-ready', '1');

        button.addEventListener('click', async function () {
            var messageId = parseInt(
                button.getAttribute('data-message-id') || '0',
                10
            );
            var endpoint = button.getAttribute('data-endpoint') || '';
            var confirmation = button.getAttribute('data-confirm') || '';

            if (
                messageId < 1
                || !endpoint
                || (
                    confirmation
                    && !window.confirm(confirmation)
                )
            ) {
                return;
            }

            var queueToken = {{ segment_queue_csrf_token|default('')|json_encode|raw }};

            if (!queueToken) {
                if (status) {
                    status.textContent = {{ 'mautic.zender.whatsapp.messages.segment_schedule.cancel_error'|trans|json_encode|raw }};
                    status.classList.remove('hide');
                }

                return;
            }

            var formData = new FormData();
            formData.set('_token', queueToken);
            formData.set('message_id', String(messageId));

            button.disabled = true;

            if (status) {
                status.textContent = {{ 'mautic.zender.whatsapp.messages.segment_schedule.cancelling'|trans|json_encode|raw }};
                status.classList.remove('hide');
            }

            try {
                var response = await window.fetch(
                    endpoint,
                    {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Accept': 'application/json'
                        },
                        body: formData
                    }
                );

                var rawBody = await response.text();
                var payload = null;

                try {
                    payload = JSON.parse(rawBody);
                } catch (parseError) {
                    payload = null;
                }

                if (!response.ok || !payload || !payload.ok) {
                    throw new Error(
                        payload && payload.reason
                            ? String(payload.reason)
                            : 'cancel_failed'
                    );
                }

                if (status) {
                    status.textContent = {{ 'mautic.zender.whatsapp.messages.segment_schedule.cancelled'|trans|json_encode|raw }};
                }

                window.location.reload();
            } catch (error) {
                button.disabled = false;

                if (status) {
                    status.textContent = {{ 'mautic.zender.whatsapp.messages.segment_schedule.cancel_error'|trans|json_encode|raw }};
                    status.classList.remove('hide');
                }
            }
        });
    }

    if ('loading' === document.readyState) {
        document.addEventListener(
            'DOMContentLoaded',
            startQueueCancelControl
        );
    } else {
        startQueueCancelControl();
    }
}());
</script>

<script>
window.Mautic = window.Mautic || {};

Mautic.activateWhatsAppDemoContactLookupField = function (
    fieldOptions,
    filterId
) {
    var lookupElementId = 'zender_whatsapp_demo_contact';
    var action = mQuery('#' + lookupElementId).attr(
        'data-chosen-lookup'
    );
    var options = {
        limit: 20,
        searchKey: 'lead.lead'
    };

    Mautic.activateFieldTypeahead(
        lookupElementId,
        filterId,
        options,
        action
    );

    mQuery('#' + lookupElementId)
        .off('change.zenderDemoLookup')
        .on(
            'change.zenderDemoLookup',
            function (event) {
                if (event.target.value === '') {
                    mQuery(
                        '#zender_whatsapp_demo_contact_id'
                    ).val('');
                }
            }
        );
};

Mautic.updateWhatsAppDemoContactLookupListFilter = function (
    field,
    item
) {
    if (item && item.id) {
        mQuery(
            '#zender_whatsapp_demo_contact_id'
        ).val(item.id);
        mQuery(field).val(item.value);
    }
};
</script>
