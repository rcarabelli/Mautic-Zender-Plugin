{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent %}zenderWhatsAppMessages{% endblock %}
{% block headerTitle %}{{ 'mautic.zender.whatsapp.messages.title'|trans }}{% endblock %}

{% block content %}
<style>
    #zender-whatsapp-message-manager {
        max-width: 1680px;
        margin: 0 auto;
    }

    #zender-whatsapp-message-manager .zender-wa-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
        padding: 18px 20px;
        background: #fff;
        border: 1px solid #dfe3e8;
        border-radius: 4px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, .04);
    }

    #zender-whatsapp-message-manager .zender-wa-page-title {
        margin: 0 0 5px;
        font-size: 22px;
        line-height: 1.25;
        font-weight: 600;
    }

    #zender-whatsapp-message-manager .zender-wa-page-description {
        max-width: 920px;
        margin: 0;
        color: #6b7280;
        line-height: 1.5;
    }

    #zender-whatsapp-message-manager .zender-wa-page-actions {
        flex: 0 0 auto;
    }

    #zender-whatsapp-message-manager .zender-wa-layout {
        display: flex;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    #zender-whatsapp-message-manager .zender-wa-editor-panel,
    #zender-whatsapp-message-manager .zender-wa-library-panel {
        margin-bottom: 20px;
        border-color: #dfe3e8;
        box-shadow: 0 1px 3px rgba(0, 0, 0, .05);
    }

    #zender-whatsapp-message-manager .zender-wa-panel-heading {
        min-height: 52px;
        padding: 15px 18px;
        background: #f8f9fa;
        border-bottom-color: #dfe3e8;
        font-size: 15px;
    }

    #zender-whatsapp-message-manager .zender-wa-editor-body {
        padding: 18px;
        background: #f5f7f9;
    }

    #zender-whatsapp-message-manager .zender-wa-section {
        margin: 0 0 18px;
        padding: 18px;
        background: #fff;
        border: 1px solid #dfe3e8;
        border-radius: 4px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, .03);
    }

    #zender-whatsapp-message-manager .zender-wa-section-heading {
        margin: -18px -18px 18px;
        padding: 13px 18px;
        background: #fbfcfd;
        border-bottom: 1px solid #e5e7eb;
    }

    #zender-whatsapp-message-manager .zender-wa-section-heading h3,
    #zender-whatsapp-message-manager .zender-wa-section > h4 {
        margin: 0;
        font-size: 16px;
        line-height: 1.35;
        font-weight: 600;
    }

    #zender-whatsapp-message-manager .zender-wa-section > h4 {
        margin: -18px -18px 18px;
        padding: 13px 18px;
        background: #fbfcfd;
        border-bottom: 1px solid #e5e7eb;
    }

    #zender-whatsapp-message-manager .zender-wa-section-heading i,
    #zender-whatsapp-message-manager .zender-wa-section > h4 i {
        margin-right: 6px;
    }

    #zender-whatsapp-message-manager .zender-wa-section--ai {
        border-left: 3px solid #7c6ee6;
    }

    #zender-whatsapp-message-manager .zender-wa-section--delivery {
        border-left: 3px solid #2f80ed;
    }

    #zender-whatsapp-message-manager .zender-wa-section--demo {
        border-left: 3px solid #17a2b8;
    }

    #zender-whatsapp-message-manager .zender-wa-delivery-preview {
        margin-top: -6px;
        margin-bottom: 18px;
    }

    #zender-whatsapp-message-manager .zender-wa-segment-preview-card {
        padding: 18px;
        background: #fff;
    }

    #zender-whatsapp-message-manager .zender-wa-segment-preview-table {
        margin-bottom: 8px;
        table-layout: fixed;
        background: #fff;
    }

    #zender-whatsapp-message-manager .zender-wa-segment-preview-table > thead > tr > th {
        padding: 10px 12px;
        background: #f8f9fa;
        border-bottom-width: 1px;
        color: #4b5563;
        font-size: 12px;
        font-weight: 600;
        vertical-align: middle;
    }

    #zender-whatsapp-message-manager .zender-wa-segment-preview-table > tbody > tr > td {
        padding: 12px;
        vertical-align: top;
    }

    #zender-whatsapp-message-manager .zender-wa-segment-preview-table .zender-wa-preview-segments {
        width: 46%;
    }

    #zender-whatsapp-message-manager .zender-wa-segment-preview-table .zender-wa-preview-metric {
        width: 18%;
        text-align: center;
    }

    #zender-whatsapp-message-manager .zender-wa-segment-preview-table .zender-wa-preview-metric strong {
        display: block;
        margin-bottom: 4px;
        font-size: 20px;
        line-height: 1;
    }

    #zender-whatsapp-message-manager .zender-wa-preview-segment-list {
        margin: 6px 0 0;
        padding-left: 18px;
    }

    #zender-whatsapp-message-manager .zender-wa-preview-footnote {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 12px;
    }

    #zender-whatsapp-message-manager .zender-wa-segment-schedule-panel {
        margin-top: 18px;
        padding-top: 18px;
        border-top: 1px solid #dfe3e8;
    }

    #zender-whatsapp-message-manager .zender-wa-segment-schedule-panel .form-group {
        margin-bottom: 12px;
    }

    #zender-whatsapp-message-manager .zender-wa-segment-schedule-action {
        margin-top: 4px;
    }

    #zender-whatsapp-message-manager .zender-wa-segment-schedule-action .btn {
        min-width: 360px;
    }

    @media (min-width: 768px) {
        #zender-whatsapp-message-manager
        .zender-wa-segment-preview-table > tbody > tr > td.zender-wa-preview-metric {
            vertical-align: middle;
        }

        #zender-whatsapp-message-manager
        .zender-wa-segment-schedule-panel input[type="date"],
        #zender-whatsapp-message-manager
        .zender-wa-segment-schedule-panel input[type="time"] {
            height: 36px;
            padding-top: 0;
            padding-bottom: 0;
            line-height: 36px;
        }
    }

    #zender-whatsapp-message-manager .zender-wa-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 2px;
        padding: 14px 18px;
        background: #fff;
        border: 1px solid #dfe3e8;
        border-radius: 4px;
    }

    #zender-whatsapp-message-manager .zender-wa-library-panel .panel-heading {
        position: relative;
    }

    #zender-whatsapp-message-manager .zender-wa-library-panel .table {
        font-size: 12px;
    }

    #zender-whatsapp-message-manager .zender-wa-library-panel .table > thead > tr > th,
    #zender-whatsapp-message-manager .zender-wa-library-panel .table > tbody > tr > td {
        padding: 10px 8px;
        vertical-align: middle;
    }

    #zender-whatsapp-message-manager .zender-wa-library-panel .table > thead > tr > th {
        background: #fbfcfd;
        border-bottom-width: 1px;
        color: #4b5563;
        font-weight: 600;
    }

    #zender-whatsapp-message-manager .zender-wa-library-panel .btn-sm {
        white-space: nowrap;
    }

    #zender-whatsapp-message-manager .zender-wa-library-panel tbody tr:hover {
        background: #f7fafc;
    }

    #zender-whatsapp-message-manager .zender-wa-channel-note {
        margin: 0;
        padding-top: 0;
        border: 0;
        background: transparent;
    }

    @media (min-width: 992px) {
        #zender-whatsapp-message-manager .zender-wa-library-sticky {
            position: sticky;
            top: 15px;
            max-height: none;
            overflow: visible;
        }
    }

    @media (max-width: 1199px) and (min-width: 992px) {
        #zender-whatsapp-message-manager .zender-wa-editor-column {
            width: 62.5%;
        }

        #zender-whatsapp-message-manager .zender-wa-library-column {
            width: 37.5%;
        }

        #zender-whatsapp-message-manager .zender-wa-library-panel .table {
            min-width: 560px;
        }
    }

    @media (max-width: 991px) {
        #zender-whatsapp-message-manager .zender-wa-layout {
            display: block;
        }

        #zender-whatsapp-message-manager .zender-wa-library-column {
            margin-top: 0;
        }

        #zender-whatsapp-message-manager .zender-wa-library-sticky {
            position: static;
            max-height: none;
            overflow: visible;
        }
    }

    @media (max-width: 767px) {
        #zender-whatsapp-message-manager {
            padding-left: 10px;
            padding-right: 10px;
        }

        #zender-whatsapp-message-manager .zender-wa-page-header {
            display: block;
            padding: 15px;
        }

        #zender-whatsapp-message-manager .zender-wa-page-actions {
            margin-top: 14px;
        }

        #zender-whatsapp-message-manager .zender-wa-page-actions .btn {
            width: 100%;
        }

        #zender-whatsapp-message-manager .zender-wa-editor-body,
        #zender-whatsapp-message-manager .zender-wa-section {
            padding: 14px;
        }

        #zender-whatsapp-message-manager .zender-wa-section-heading,
        #zender-whatsapp-message-manager .zender-wa-section > h4 {
            margin: -14px -14px 14px;
            padding: 12px 14px;
        }

        #zender-whatsapp-message-manager .zender-wa-actions {
            display: block;
            padding: 12px 14px;
        }

        #zender-whatsapp-message-manager .zender-wa-actions .btn {
            display: block;
            width: 100%;
            margin: 0 0 8px;
        }

        #zender-whatsapp-message-manager .zender-wa-actions .btn:last-child {
            margin-bottom: 0;
        }
    }
</style>
<div class="pa-md"
     id="zender-whatsapp-message-manager"
     data-channel="whatsapp">

    {% if saved %}
        <div class="alert alert-success">
            {{ 'mautic.zender.whatsapp.messages.saved'|trans }}
        </div>
    {% endif %}

    {% if demo_enqueued %}
        <div class="alert {% if demo_status == 'blocked_account' %}alert-warning{% else %}alert-success{% endif %}">
            {{ 'mautic.zender.whatsapp.messages.demo.queued'|trans({
                '%contact%': demo_contact_id,
                '%queue%': demo_queue_id,
                '%status%': demo_status == 'blocked_account'
                    ? 'mautic.zender.whatsapp.messages.demo.status.blocked_account'|trans
                    : 'mautic.zender.whatsapp.messages.demo.status.pending'|trans
            }) }}
        </div>
    {% endif %}

    {% if error %}
        <div class="alert alert-danger">
            {% if error == 'csrf' %}
                {{ 'mautic.zender.whatsapp.messages.csrf_error'|trans }}
            {% elseif error starts with 'mautic.' %}
                {{ error|trans }}
            {% else %}
                {{ error }}
            {% endif %}
        </div>
    {% endif %}

    <div class="zender-wa-page-header">
        <div>
            <h2 class="zender-wa-page-title">
                <i class="ri-whatsapp-line" aria-hidden="true"></i>
                {{ 'mautic.zender.whatsapp.messages.title'|trans }}
            </h2>
            <p class="zender-wa-page-description">
                <strong>{{ 'mautic.zender.whatsapp.messages.channel_title'|trans }}.</strong>
                {{ 'mautic.zender.whatsapp.messages.channel_help'|trans }}
            </p>
        </div>
        <div class="zender-wa-page-actions">
            <a class="btn btn-default" href="{{ path('mautic_zender_whatsapp_messages') }}">
                <i class="ri-add-line" aria-hidden="true"></i>
                {{ 'mautic.zender.whatsapp.messages.new'|trans }}
            </a>
        </div>
    </div>

    <div class="row zender-wa-layout">
        <div class="col-md-8 zender-wa-editor-column">
            <div class="panel panel-default zender-wa-editor-panel">
                <div class="panel-heading zender-wa-panel-heading">
                    <strong>
                        {% if selected_message %}
                            <i class="ri-edit-line" aria-hidden="true"></i>
                            {{ 'mautic.zender.whatsapp.messages.edit'|trans }}: {{ selected_message.name }}
                        {% else %}
                            <i class="ri-add-circle-line" aria-hidden="true"></i>
                            {{ 'mautic.zender.whatsapp.messages.new'|trans }}
                        {% endif %}
                    </strong>
                </div>
                <div class="panel-body zender-wa-editor-body">
                    {% if can_edit %}
                        <form method="post"
                              enctype="multipart/form-data"
                              action="{{ path('mautic_zender_whatsapp_messages') }}">
                            <input type="hidden"
                                   name="_token"
                                   value="{{ csrf_token }}">
                            <input type="hidden"
                                   name="message_id"
                                   value="{{ selected_message.id|default('') }}">

                            <section class="zender-wa-section zender-wa-section--content">
                                <div class="zender-wa-section-heading">
                                    <h3>
                                        <i class="ri-message-2-line" aria-hidden="true"></i>
                                        {{ 'mautic.zender.whatsapp.messages.content'|trans }}
                                    </h3>
                                </div>

                            <div class="form-group">
                                <label for="zender-whatsapp-message-name">
                                    {{ 'mautic.zender.whatsapp.messages.name'|trans }}
                                </label>
                                <input type="text"
                                       class="form-control"
                                       id="zender-whatsapp-message-name"
                                       name="name"
                                       maxlength="191"
                                       required
                                       value="{{ selected_message.name|default('') }}">
                            </div>

                            <div class="form-group">
                                <label for="zender-whatsapp-message-content">
                                    {{ 'mautic.zender.whatsapp.messages.content'|trans }}
                                </label>
                                <textarea class="form-control"
                                          id="zender-whatsapp-message-content"
                                          name="content"
                                          rows="12"
                                          maxlength="65535"
                                          required>{{ selected_message.content|default('') }}</textarea>
                                <div class="mt-sm"
                                     id="zender-whatsapp-contact-token-toolbar">
                                    <label class="control-label">
                                        {{ 'mautic.zender.whatsapp.messages.tokens.title'|trans }}
                                    </label>
                                    <div class="btn-group btn-group-sm mb-xs"
                                         role="group"
                                         aria-label="{{ 'mautic.zender.whatsapp.messages.tokens.title'|trans }}">
                                        <button type="button"
                                                class="btn btn-default"
                                                data-whatsapp-contact-token="{contactfield=firstname}">
                                            {{ 'mautic.zender.whatsapp.messages.tokens.firstname'|trans }}
                                        </button>
                                        <button type="button"
                                                class="btn btn-default"
                                                data-whatsapp-contact-token="{contactfield=lastname}">
                                            {{ 'mautic.zender.whatsapp.messages.tokens.lastname'|trans }}
                                        </button>
                                        <button type="button"
                                                class="btn btn-default"
                                                data-whatsapp-contact-token="{contactfield=email}">
                                            {{ 'mautic.zender.whatsapp.messages.tokens.email'|trans }}
                                        </button>
                                        <button type="button"
                                                class="btn btn-default"
                                                data-whatsapp-contact-token="{contactfield=phone}">
                                            {{ 'mautic.zender.whatsapp.messages.tokens.phone'|trans }}
                                        </button>
                                        <button type="button"
                                                class="btn btn-default"
                                                data-whatsapp-contact-token="{contactfield=mobile}">
                                            {{ 'mautic.zender.whatsapp.messages.tokens.mobile'|trans }}
                                        </button>
                                        <button type="button"
                                                class="btn btn-default"
                                                data-whatsapp-contact-token="{contactfield=company}">
                                            {{ 'mautic.zender.whatsapp.messages.tokens.company'|trans }}
                                        </button>
                                        <button type="button"
                                                class="btn btn-default"
                                                data-whatsapp-contact-token="{contactfield=position}">
                                            {{ 'mautic.zender.whatsapp.messages.tokens.position'|trans }}
                                        </button>
                                        <button type="button"
                                                class="btn btn-default"
                                                data-whatsapp-contact-token="{contactfield=city}">
                                            {{ 'mautic.zender.whatsapp.messages.tokens.city'|trans }}
                                        </button>
                                        <button type="button"
                                                class="btn btn-default"
                                                data-whatsapp-contact-token="{contactfield=country}">
                                            {{ 'mautic.zender.whatsapp.messages.tokens.country'|trans }}
                                        </button>
                                    </div>

                                    <div class="input-group input-group-sm">
                                        <input type="text"
                                               class="form-control"
                                               id="zender-whatsapp-custom-token-alias"
                                               maxlength="191"
                                               autocomplete="off"
                                               placeholder="{{ 'mautic.zender.whatsapp.messages.tokens.custom_placeholder'|trans }}">
                                        <span class="input-group-btn">
                                            <button type="button"
                                                    class="btn btn-default"
                                                    id="zender-whatsapp-insert-custom-token">
                                                {{ 'mautic.zender.whatsapp.messages.tokens.insert_custom'|trans }}
                                            </button>
                                        </span>
                                    </div>

                                    <p class="help-block">
                                        {{ 'mautic.zender.whatsapp.messages.tokens'|trans }}
                                    </p>
                                    <p class="help-block">
                                        {{ 'mautic.zender.whatsapp.messages.tokens.fallback'|trans }}
                                    </p>
                                    <p class="help-block text-danger hide"
                                       id="zender-whatsapp-token-error"
                                       role="alert">
                                        {{ 'mautic.zender.whatsapp.messages.tokens.invalid_alias'|trans }}
                                    </p>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="zender-whatsapp-message-multimedia-file">
                                    {{ 'mautic.zender.whatsapp.messages.multimedia'|trans }}
                                </label>
                                <input class="form-control"
                                       type="file"
                                       id="zender-whatsapp-message-multimedia-file"
                                       name="multimedia_file">
                                       <input type="hidden"
                                              name="asset_id"
                                              value="{{ selected_message.asset_id|default('') }}">
                                <p class="help-block">
                                    {{ 'mautic.zender.whatsapp.messages.multimedia.upload_help'|trans }}
                                </p>
                                {% if selected_asset %}
                                    <div class="well well-sm mt-sm" id="zender-whatsapp-current-attachment">
                                        <strong>{{ 'mautic.zender.whatsapp.messages.multimedia.current'|trans }}</strong>
                                        {% if selected_asset.is_image and selected_asset.url %}
                                            <div class="mt-sm mb-sm">
                                                <a href="{{ selected_asset.url }}" target="_blank" rel="noopener">
                                                    <img class="img-thumbnail"
                                                         src="{{ selected_asset.url }}"
                                                         alt="{{ selected_asset.original_name }}"
                                                         style="max-width: 240px; max-height: 240px;">
                                                </a>
                                            </div>
                                        {% endif %}
                                        <p class="mb-xs"><strong>{{ selected_asset.original_name }}</strong></p>
                                        <p class="text-muted mb-xs">
                                            {% if selected_asset.mime %}{{ selected_asset.mime }}{% endif %}
                                            {% if selected_asset.mime and selected_asset.size_label %} · {% endif %}
                                            {% if selected_asset.size_label %}{{ selected_asset.size_label }}{% endif %}
                                        </p>
                                        {% if selected_asset.url %}
                                            <a class="btn btn-sm btn-default"
                                               href="{{ selected_asset.url }}"
                                               target="_blank" rel="noopener">
                                                <i class="ri-external-link-line"></i>
                                                {{ 'mautic.zender.whatsapp.messages.multimedia.open'|trans }}
                                            </a>
                                        {% endif %}
                                        <p class="help-block mb-0">
                                            {{ 'mautic.zender.whatsapp.messages.multimedia.replace_help'|trans }}
                                        </p>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="checkbox">
                                <label>
                                    <input type="checkbox"
                                           name="is_published"
                                           value="1"
                                           {% if selected_message is null or selected_message.is_published %}checked{% endif %}>
                                    {{ 'mautic.zender.whatsapp.messages.published'|trans }}
                                </label>
                            </div>

                            </section>

                            {# AI_SPINTAX_STEP1A_VISUAL_CONTROLS_BEGIN #}
                            <div class="zender-wa-section zender-wa-section--ai"
                                 id="zender-whatsapp-ai-spintax-controls">
                                <h4 class="mb-sm">
                                    {{ 'mautic.zender.whatsapp.messages.spintax.title'|trans }}
                                </h4>

                                <div class="checkbox mb-md">
                                    <label for="zender-whatsapp-ai-spintax-enabled">
                                        <input type="checkbox"
                                               id="zender-whatsapp-ai-spintax-enabled"
                                               name="ai_spintax_enabled"
                                               value="1">
                                        {{ 'mautic.zender.whatsapp.messages.spintax.enable'|trans }}
                                    </label>
                                </div>

                                <p class="help-block">
                                    {{ 'mautic.zender.whatsapp.messages.spintax.enable_help'|trans }}
                                </p>

                                <div class="row">
                                    <div class="col-xs-12 col-sm-6">
                                        <div class="form-group">
                                            <label for="zender-whatsapp-ai-spintax-style">
                                                {{ 'mautic.zender.whatsapp.messages.spintax.style.label'|trans }}
                                            </label>
                                            <select class="form-control not-chosen"
                                                    id="zender-whatsapp-ai-spintax-style"
                                                    name="ai_spintax_style">
                                                <option value="mixed" selected>
                                                    {{ 'mautic.zender.whatsapp.messages.spintax.style.mixed'|trans }}
                                                </option>
                                                <option value="words">
                                                    {{ 'mautic.zender.whatsapp.messages.spintax.style.words'|trans }}
                                                </option>
                                                <option value="phrases">
                                                    {{ 'mautic.zender.whatsapp.messages.spintax.style.phrases'|trans }}
                                                </option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-xs-12 col-sm-6">
                                        <div class="form-group">
                                            <label for="zender-whatsapp-ai-spintax-level">
                                                {{ 'mautic.zender.whatsapp.messages.spintax.level.label'|trans }}
                                            </label>
                                            <select class="form-control not-chosen"
                                                    id="zender-whatsapp-ai-spintax-level"
                                                    name="ai_spintax_level">
                                                <option value="minimum_3x3" selected>
                                                    {{ 'mautic.zender.whatsapp.messages.spintax.level.minimum'|trans }}
                                                </option>
                                                <option value="balanced_5x3">
                                                    {{ 'mautic.zender.whatsapp.messages.spintax.level.balanced'|trans }}
                                                </option>
                                                <option value="high_8x4">
                                                    {{ 'mautic.zender.whatsapp.messages.spintax.level.high'|trans }}
                                                </option>
                                                <option value="custom">
                                                    {{ 'mautic.zender.whatsapp.messages.spintax.level.custom'|trans }}
                                                </option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-xs-12 col-sm-6">
                                        <div class="form-group">
                                            <label for="zender-whatsapp-ai-spintax-min-blocks">
                                                {{ 'mautic.zender.whatsapp.messages.spintax.custom.blocks'|trans }}
                                            </label>
                                            <input type="number"
                                                   class="form-control"
                                                   id="zender-whatsapp-ai-spintax-min-blocks"
