{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent %}zenderControl{% endblock %}
{% block headerTitle %}
<span style="display:inline-flex !important; flex-direction:column !important; align-items:flex-start !important; justify-content:flex-start !important; gap:0 !important; max-width:100%; line-height:1.05; vertical-align:middle;">
    <span style="display:block !important; width:auto !important; margin:0 0 2px 0 !important; padding:0 !important; color:#ff001a; font-size:10px; line-height:1.2; font-weight:800; letter-spacing:.12em; text-transform:uppercase; white-space:nowrap;">7 CATS STUDIO</span>
    <span style="display:block !important; width:auto !important; margin:0 !important; padding:0 !important; white-space:nowrap;">Zender Control</span>
</span>
{% endblock %}

{% block content %}
<style id="zcs-global-footer-signature-v1">
    #zender-control-brand-signature {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        margin-top: 30px;
        padding: 24px 16px 12px;
        border-top: 1px solid #e5e7eb;
        text-align: center;
    }

    #zender-control-brand-signature
    .zender-control-brand-signature-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        max-width: 100%;
        padding: 8px 12px;
        border-radius: 10px;
        text-decoration: none;
        transition:
            background-color .16s ease,
            box-shadow .16s ease,
            transform .16s ease;
    }

    #zender-control-brand-signature
    .zender-control-brand-signature-link:hover,
    #zender-control-brand-signature
    .zender-control-brand-signature-link:focus {
        background: #fff7f8;
        box-shadow: 0 4px 14px rgba(15, 23, 42, .08);
        transform: translateY(-1px);
        outline: none;
    }

    #zender-control-brand-signature
    .zender-control-brand-signature-logo {
        display: block;
        max-width: 100%;
        object-fit: contain;
    }

    #zender-control-brand-signature
    .zender-control-brand-signature-logo-wide {
        width: 180px;
        height: auto;
    }

    #zender-control-brand-signature
    .zender-control-brand-signature-logo-mark {
        display: none;
        width: 52px;
        height: 52px;
    }

    @media (max-width: 767px) {
        #zender-control-brand-signature {
            margin-top: 22px;
            padding: 20px 10px 8px;
        }

        #zender-control-brand-signature
        .zender-control-brand-signature-logo-wide {
            display: none;
        }

        #zender-control-brand-signature
        .zender-control-brand-signature-logo-mark {
            display: block;
        }
    }
</style>

<div id="zender-control-tabs"
     class="pa-md"
     data-zender-tabs-stage="diagnostics-restored-v1">

    {% set receivedChatsActive =
        received_chats_active|default(false)
    %}
    {% set queueHistoryPaginationActive =
        queue_history_active|default(false)
        and not receivedChatsActive
    %}
    {% set zenderSettingsTabActive =
        app.request.query.has('settings_tab')
        and not receivedChatsActive
        and not queueHistoryPaginationActive
    %}
    {% set whatsappCampaignsActive =
        whatsapp_campaigns_active|default(false)
        and not receivedChatsActive
        and not queueHistoryPaginationActive
        and not zenderSettingsTabActive
    %}

    <ul class="nav nav-tabs"
        id="zender-control-tab-list"
        role="tablist">
        <li role="presentation">
            <a href="#zender-tab-overview"
               id="zender-tab-overview-link"
               aria-controls="zender-tab-overview"
               role="tab"
               data-toggle="tab"
               aria-selected="false">
                {{ 'mautic.zender.tab.overview'|trans }}
            </a>
        </li>
        <li role="presentation">
            <a href="#zender-tab-sending"
               id="zender-tab-sending-link"
               aria-controls="zender-tab-sending"
               role="tab"
               data-toggle="tab"
               aria-selected="false">
                {{ 'mautic.zender.tab.sending'|trans }}
            </a>
        </li>
        <li role="presentation">
            <a href="#zender-tab-accounts"
               id="zender-tab-accounts-link"
               aria-controls="zender-tab-accounts"
               role="tab"
               data-toggle="tab"
               aria-selected="false">
                {{ 'mautic.zender.tab.accounts'|trans }}
            </a>
        </li>
        <li role="presentation"{% if queueHistoryPaginationActive %} class="active"{% endif %}>
            <a href="#zender-tab-queue"
               id="zender-tab-queue-link"
               aria-controls="zender-tab-queue"
               role="tab"
               data-toggle="tab"
               aria-selected="{{ queueHistoryPaginationActive ? 'true' : 'false' }}">
                {{ 'mautic.zender.tab.queue'|trans }}
            </a>
        </li>
        <li role="presentation"{% if whatsappCampaignsActive %} class="active"{% endif %}>
            <a href="#zender-tab-whatsapp-campaigns"
               id="zender-tab-whatsapp-campaigns-link"
               aria-controls="zender-tab-whatsapp-campaigns"
               role="tab"
               data-toggle="tab"
               aria-selected="{{ whatsappCampaignsActive ? 'true' : 'false' }}">
                {{ 'mautic.zender.tab.whatsapp_campaigns'|trans }}
            </a>
        </li>
        <li role="presentation"{% if receivedChatsActive %} class="active"{% endif %}>
            <a href="#zender-tab-received"
               id="zender-tab-received-link"
               aria-controls="zender-tab-received"
               role="tab"
               data-toggle="tab"
               aria-selected="{{ receivedChatsActive ? 'true' : 'false' }}">
                {{ 'mautic.zender.tab.received'|trans }}
            </a>
        </li>
        <li role="presentation"{% if zenderSettingsTabActive %} class="active"{% endif %}>
            <a href="#zender-tab-settings"
               id="zender-tab-settings-link"
               aria-controls="zender-tab-settings"
               role="tab"
               data-toggle="tab"
               aria-selected="{{ zenderSettingsTabActive ? 'true' : 'false' }}">
                {{ 'mautic.zender.tab.settings'|trans }}
            </a>
        </li>
        <li role="presentation"{% if not queueHistoryPaginationActive and not zenderSettingsTabActive and not receivedChatsActive and not whatsappCampaignsActive %} class="active"{% endif %}>
            <a href="#zender-tab-diagnostics"
               id="zender-tab-diagnostics-link"
               aria-controls="zender-tab-diagnostics"
               role="tab"
               data-toggle="tab"
               aria-selected="{{ queueHistoryPaginationActive or zenderSettingsTabActive or receivedChatsActive or whatsappCampaignsActive ? 'false' : 'true' }}">
                {{ 'mautic.zender.tab.diagnostics'|trans }}
            </a>
        </li>
    </ul>

    <div class="tab-content"
         id="zender-control-tab-content">
        <div role="tabpanel"
             class="tab-pane"
             id="zender-tab-overview"
             aria-labelledby="zender-tab-overview-link"></div>

        {# SENDING_SPEED_VISUAL_3A5V1 #}
        {% set sending = dashboard.sending|default({
            marker: 'ZENDER_SENDING_SPEED_READ_ONLY_3A5V1',
            dispatcher_enabled: false,
            interval_seconds: 0,
            window_start: '—',
            window_end: '—',
            timezone: 'UTC',
            live_work_ids: 0,
            ready_ids: 0,
            cooldown_ids: 0,
            waiting_queue_ids: 0,
            quota_reached_ids: 0,
            no_work_ids: 0,
            disabled_ids: 0,
            next_eligible_at: null,
            next_eligible_in_seconds: null
        }) %}
        <div role="tabpanel"
             class="tab-pane"
             id="zender-tab-sending"
             aria-labelledby="zender-tab-sending-link">
            <div class="pa-md zender-sending-speed"
                 id="zender-sending-speed"
                 data-zender-sending-stage="3a5v1-read-only"
                 data-zender-ready-ids="{{ sending.ready_ids }}"
                 data-zender-cooldown-ids="{{ sending.cooldown_ids }}">
                <style>
                    #zender-sending-speed {
                        --zss-border: #dfe3ea;
                        --zss-muted: #6b7280;
                        --zss-surface: #ffffff;
                        --zss-soft: #f7f9fc;
                        --zss-radius: 16px;
                        --zss-shadow: 0 10px 30px rgba(15, 23, 42, .07);
                    }
                    #zender-sending-speed * { box-sizing: border-box; }
                    #zender-sending-speed .zss-shell {
                        display: flex;
                        flex-direction: column;
                        gap: 18px;
                    }
                    #zender-sending-speed .zss-hero {
                        display: flex;
                        justify-content: space-between;
                        gap: 20px;
                        align-items: flex-start;
                        padding: 20px;
                        border: 1px solid var(--zss-border);
                        border-radius: var(--zss-radius);
                        background: linear-gradient(135deg, #ffffff, #f2f6ff);
                        box-shadow: var(--zss-shadow);
                    }
                    #zender-sending-speed .zss-hero h2 {
                        margin: 0 0 7px;
                        font-size: 24px;
                    }
                    #zender-sending-speed .zss-hero p {
                        margin: 0;
                        color: var(--zss-muted);
                        line-height: 1.5;
                    }
                    #zender-sending-speed .zss-status {
                        display: inline-flex;
                        align-items: center;
                        gap: 8px;
                        padding: 9px 14px;
                        border-radius: 999px;
                        font-weight: 700;
                        white-space: nowrap;
                    }
                    #zender-sending-speed .zss-status-active {
                        background: #e8f7ee;
                        color: #16753a;
                    }
                    #zender-sending-speed .zss-status-stopped {
                        background: #fdecec;
                        color: #a12626;
                    }
                    #zender-sending-speed .zss-summary {
                        display: grid;
                        grid-template-columns: repeat(4, minmax(0, 1fr));
                        gap: 12px;
                    }
                    #zender-sending-speed .zss-card {
                        min-height: 108px;
                        padding: 16px;
                        background: var(--zss-surface);
                        border: 1px solid var(--zss-border);
                        border-radius: var(--zss-radius);
                        box-shadow: var(--zss-shadow);
                    }
                    #zender-sending-speed .zss-card-label {
                        display: block;
                        color: var(--zss-muted);
                        font-size: 12px;
                        text-transform: uppercase;
                        letter-spacing: .04em;
                        margin-bottom: 10px;
                    }
                    #zender-sending-speed .zss-card-value {
                        display: block;
                        font-size: 28px;
                        font-weight: 750;
                        line-height: 1.05;
                        color: #111827;
                    }
                    #zender-sending-speed .zss-card-meta {
                        display: block;
                        margin-top: 8px;
                        color: var(--zss-muted);
                        font-size: 12px;
                    }
                    #zender-sending-speed .zss-panel {
                        overflow: hidden;
                        border: 1px solid var(--zss-border);
                        border-radius: var(--zss-radius);
                        background: var(--zss-surface);
                        box-shadow: var(--zss-shadow);
                    }
                    #zender-sending-speed .zss-panel-heading {
                        padding: 18px 20px;
                        border-bottom: 1px solid var(--zss-border);
                        background: var(--zss-soft);
                    }
                    #zender-sending-speed .zss-panel-heading h3 {
                        margin: 0 0 5px;
                        font-size: 19px;
                    }
                    #zender-sending-speed .zss-panel-heading p {
                        margin: 0;
                        color: var(--zss-muted);
                    }
                    #zender-sending-speed table { margin-bottom: 0; }
                    #zender-sending-speed th {
                        color: var(--zss-muted);
                        font-size: 11px;
                        text-transform: uppercase;
                        letter-spacing: .04em;
                        background: #fff;
                    }
                    #zender-sending-speed td { vertical-align: middle; }
                    #zender-sending-speed .zss-account strong {
                        display: block;
                        margin-bottom: 3px;
                    }
                    #zender-sending-speed .zss-account small {
                        color: var(--zss-muted);
                    }
                    #zender-sending-speed .zss-state {
                        display: inline-flex;
                        padding: 6px 10px;
                        border-radius: 999px;
                        font-size: 12px;
                        font-weight: 700;
                    }
                    #zender-sending-speed .zss-ready { background: #e8f7ee; color: #16753a; }
                    #zender-sending-speed .zss-cooldown { background: #fff4d6; color: #8a5b00; }
                    #zender-sending-speed .zss-waiting { background: #e8f1ff; color: #2457a6; }
                    #zender-sending-speed .zss-quota { background: #fdecec; color: #a12626; }
                    #zender-sending-speed .zss-muted { background: #eef0f3; color: #59616d; }
                    #zender-sending-speed .zss-footnote {
                        padding: 14px 20px;
                        border-top: 1px solid var(--zss-border);
                        color: var(--zss-muted);
                        background: var(--zss-soft);
                    }
                    @media (max-width: 1100px) {
                        #zender-sending-speed .zss-summary {
                            grid-template-columns: repeat(2, minmax(0, 1fr));
                        }
                    }
                    @media (max-width: 767px) {
                        #zender-sending-speed { padding: 12px; }
                        #zender-sending-speed .zss-hero {
                            flex-direction: column;
                        }
                        #zender-sending-speed .zss-summary {
                            grid-template-columns: 1fr;
                        }
                    }
                </style>

                <div class="zss-shell">
                    <div class="zss-hero">
                        <div>
                            <h2>{{ 'mautic.zender.sending.title'|trans }}</h2>
                            <p>{{ 'mautic.zender.sending.subtitle'|trans }}</p>
                            <p>
                                {{ 'mautic.zender.sending.interval'|trans }}:
                                <strong>{{ sending.interval_seconds }}</strong>
                                {{ 'mautic.zender.sending.seconds'|trans }}
                                · {{ 'mautic.zender.sending.window'|trans }}:
                                <strong>{{ sending.window_start }}–{{ sending.window_end }}</strong>
                                {{ sending.timezone }}
                            </p>
                        </div>
                        <span class="zss-status {{ sending.dispatcher_enabled ? 'zss-status-active' : 'zss-status-stopped' }}">
                            {{ sending.dispatcher_enabled
                                ? ('mautic.zender.sending.dispatcher_active'|trans)
                                : ('mautic.zender.sending.dispatcher_stopped'|trans)
                            }}
                        </span>
                    </div>

                    <div class="zss-summary">
                        <div class="zss-card">
                            <span class="zss-card-label">{{ 'mautic.zender.sending.ready_ids'|trans }}</span>
                            <span class="zss-card-value">{{ sending.ready_ids }}</span>
                            <span class="zss-card-meta">{{ 'mautic.zender.sending.ready_ids_help'|trans }}</span>
                        </div>
                        <div class="zss-card">
                            <span class="zss-card-label">{{ 'mautic.zender.sending.cooldown_ids'|trans }}</span>
                            <span class="zss-card-value">{{ sending.cooldown_ids }}</span>
                            <span class="zss-card-meta">{{ 'mautic.zender.sending.cooldown_ids_help'|trans }}</span>
                        </div>
                        <div class="zss-card">
                            <span class="zss-card-label">{{ 'mautic.zender.sending.live_work_ids'|trans }}</span>
                            <span class="zss-card-value">{{ sending.live_work_ids }}</span>
                            <span class="zss-card-meta">{{ 'mautic.zender.sending.live_work_ids_help'|trans }}</span>
                        </div>
                        <div class="zss-card">
                            <span class="zss-card-label">{{ 'mautic.zender.sending.next_available'|trans }}</span>
                            <span class="zss-card-value" style="font-size: 17px; line-height: 1.25;">
                                {{ sending.next_eligible_at ?: '—' }}
                            </span>
                            <span class="zss-card-meta">
                                {% if sending.next_eligible_in_seconds is not null %}
                                    {{ sending.next_eligible_in_seconds }}
                                    {{ 'mautic.zender.sending.seconds'|trans }}
                                {% else %}
                                    {{ 'mautic.zender.sending.no_scheduled_cooldown'|trans }}
                                {% endif %}
                            </span>
                        </div>
                    </div>

                    <div class="zss-panel">
                        <div class="zss-panel-heading">
                            <h3>{{ 'mautic.zender.sending.table_title'|trans }}</h3>
                            <p>{{ 'mautic.zender.sending.table_subtitle'|trans }}</p>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover table-striped"
                                   id="zender-sending-speed-table">
                                <thead>
                                    <tr>
                                        <th>{{ 'mautic.zender.sending.order'|trans }}</th>
                                        <th>{{ 'mautic.zender.sending.account'|trans }}</th>
                                        <th>{{ 'mautic.zender.sending.phone'|trans }}</th>
                                        <th>{{ 'mautic.zender.sending.queue'|trans }}</th>
                                        <th>{{ 'mautic.zender.sending.state'|trans }}</th>
                                        <th>{{ 'mautic.zender.sending.last_attempt'|trans }}</th>
                                        <th>{{ 'mautic.zender.sending.next_eligible'|trans }}</th>
                                        <th class="text-right">{{ 'mautic.zender.sending.today_quota'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for account in dashboard.accounts|default([]) %}
                                        <tr data-zender-sending-account="{{ account.account_hash }}"
                                            data-zender-sending-state="{{ account.sending_state|default('disabled') }}">
                                            <td>{{ account.dispatch_order }}</td>
                                            <td class="zss-account">
                                                <strong>{{ account.label }}</strong>
                                                <small>{{ 'mautic.zender.reference'|trans }} {{ account.account_hash }}</small>
                                            </td>
                                            <td>
                                                {{ account.live_phone
                                                    ?: account.configured_phone
                                                    ?: ('mautic.zender.phone_admin.not_reported'|trans)
                                                }}
                                            </td>
                                            <td>
                                                <strong>{{ account.available_now|default(0) }}</strong>
                                                / {{ account.pending|default(0) }}
                                                <br>
                                                <small class="text-muted">{{ 'mautic.zender.sending.available_now'|trans }}</small>
                                            </td>
                                            <td>
                                                {% if account.sending_state == 'ready' %}
                                                    <span class="zss-state zss-ready">{{ 'mautic.zender.sending.state.ready'|trans }}</span>
                                                {% elseif account.sending_state == 'cooldown' %}
                                                    <span class="zss-state zss-cooldown">{{ 'mautic.zender.sending.state.cooldown'|trans }}</span>
                                                    <br><small>{{ account.cooldown_remaining_seconds }} {{ 'mautic.zender.sending.seconds'|trans }}</small>
                                                {% elseif account.sending_state == 'waiting_queue' %}
                                                    <span class="zss-state zss-waiting">{{ 'mautic.zender.sending.state.waiting_queue'|trans }}</span>
                                                {% elseif account.sending_state == 'quota_reached' %}
                                                    <span class="zss-state zss-quota">{{ 'mautic.zender.sending.state.quota_reached'|trans }}</span>
                                                {% elseif account.sending_state == 'no_work' %}
                                                    <span class="zss-state zss-muted">{{ 'mautic.zender.sending.state.no_work'|trans }}</span>
                                                {% else %}
                                                    <span class="zss-state zss-muted">{{ 'mautic.zender.sending.state.disabled'|trans }}</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ account.last_attempt_started_at ?: '—' }}</td>
                                            <td>{{ account.next_eligible_at ?: '—' }}</td>
                                            <td class="text-right">
                                                {{ account.dispatched_today|default(0) }}
                                                / {{ account.daily_limit|default(0) }}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="8" class="text-center text-muted pa-md">
                                                {{ 'mautic.zender.phone_admin.no_accounts'|trans }}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        <div class="zss-footnote">
                            {{ 'mautic.zender.sending.readonly_note'|trans }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# PHONE_ACCOUNT_ADMIN_2A2_READ_ONLY_ACCOUNTS_WORKSPACE_V1 #}
        <div role="tabpanel"
             class="tab-pane"
             id="zender-tab-accounts"
             aria-labelledby="zender-tab-accounts-link">
            <div class="pa-md zender-phone-accounts-workspace"
                 id="zender-phone-accounts-workspace"
                 data-phone-account-admin-stage="2a2-read-only-workspace"
                 data-phone-account-count="{{ dashboard.accounts_total|default(0) }}"
                 data-phone-account-enabled="{{ dashboard.accounts_enabled|default(0) }}">
                <style>
                    #zender-phone-accounts-workspace .zpa-summary {
                        display: grid;
                        grid-template-columns: repeat(4, minmax(0, 1fr));
                        gap: 12px;
                        margin-bottom: 18px;
                    }
                    #zender-phone-accounts-workspace .zpa-summary-card {
                        border: 1px solid #dfe3ea;
                        border-radius: 14px;
                        background: #fff;
                        padding: 14px 16px;
                        min-height: 92px;
                    }
                    #zender-phone-accounts-workspace .zpa-summary-label {
                        display: block;
                        color: #6b7280;
                        font-size: 12px;
                        text-transform: uppercase;
                        letter-spacing: .04em;
                        margin-bottom: 8px;
                    }
                    #zender-phone-accounts-workspace .zpa-summary-value {
                        display: block;
                        color: #111827;
                        font-size: 24px;
                        font-weight: 700;
                        line-height: 1.15;
                    }
                    #zender-phone-accounts-workspace .zpa-panel-heading {
                        display: flex;
                        align-items: flex-start;
                        justify-content: space-between;
                        gap: 16px;
                    }
                    #zender-phone-accounts-workspace .zpa-panel-heading h3 {
                        margin: 0 0 5px;
                        font-size: 20px;
                    }
                    #zender-phone-accounts-workspace .zpa-panel-heading p {
                        margin: 0;
                    }
                    #zender-phone-accounts-workspace .zpa-account-name {
                        min-width: 180px;
                    }
                    #zender-phone-accounts-workspace .zpa-account-name strong {
                        display: block;
                        margin-bottom: 4px;
                    }
                    #zender-phone-accounts-workspace .zpa-account-name small {
                        color: #6b7280;
                    }
                    #zender-phone-accounts-workspace td {
                        vertical-align: middle;
                    }
                    #zender-phone-accounts-workspace .zpa-readonly-note {
                        margin: 0;
                    }
                    @media (max-width: 1100px) {
                        #zender-phone-accounts-workspace .zpa-summary {
                            grid-template-columns: repeat(2, minmax(0, 1fr));
                        }
                    }
                    @media (max-width: 767px) {
                        #zender-phone-accounts-workspace .zpa-summary {
                            grid-template-columns: 1fr;
                        }
                        #zender-phone-accounts-workspace .zpa-panel-heading {
                            flex-direction: column;
                            align-items: stretch;
                        }
                        #zender-phone-accounts-workspace
                        #zender-phone-accounts-manage-enabled {
                            width: 100%;
                        }
                    }
                </style>

                <div class="zpa-summary"
                     id="zender-phone-accounts-summary">
                    <div class="zpa-summary-card">
                        <span class="zpa-summary-label">
                            {{ 'mautic.zender.phone_admin.configured_accounts'|trans }}
                        </span>
                        <span class="zpa-summary-value"
                              id="zender-phone-accounts-total">
                            {{ dashboard.accounts_total|default(0) }}
                        </span>
                    </div>
                    <div class="zpa-summary-card">
                        <span class="zpa-summary-label">
                            Enabled / {{ 'mautic.zender.phone_admin.enabled_accounts'|trans }}
                        </span>
                        <span class="zpa-summary-value"
                              id="zender-phone-accounts-enabled">
                            {{ dashboard.accounts_enabled|default(0) }}
                        </span>
                    </div>
                    <div class="zpa-summary-card">
                        <span class="zpa-summary-label">
                            {{ 'mautic.zender.phone_admin.connected_accounts'|trans }}
                        </span>
                        <span class="zpa-summary-value"
                              id="zender-phone-accounts-connected">
                            {{ dashboard.live.managed_connected|default(0) }}
                        </span>
                    </div>
                    <div class="zpa-summary-card">
                        <span class="zpa-summary-label">
                            {{ 'mautic.zender.phone_admin.global_capacity_available'|trans }}
                        </span>
                        <span class="zpa-summary-value"
                              id="zender-phone-accounts-global-remaining">
                            {{ dashboard.today.remaining_global|default(0) }}
                        </span>
                    </div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading zpa-panel-heading">
                        <div>
                            <h3>{{ 'mautic.zender.phone_admin.title'|trans }}</h3>
                            <p class="text-muted">
                                {{ 'mautic.zender.phone_admin.subtitle'|trans }}
                                {{ 'mautic.zender.phone_admin.readonly_stage'|trans }}
                            </p>
                        </div>
                        <a class="btn btn-primary"
                           id="zender-phone-accounts-manage-enabled"
                           href="{{ path(
                               'mautic_zender_control_index',
                               {settings_tab: 1}
                           ) }}#zender-tab-settings">
                            {{ 'mautic.zender.phone_admin.manage_enablement'|trans }}
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0"
                               id="zender-phone-accounts-table">
                            <thead>
                                <tr>
                                    <th>{{ 'mautic.zender.phone_admin.order'|trans }}</th>
                                    <th>{{ 'mautic.zender.phone_admin.account'|trans }}</th>
                                    <th>{{ 'mautic.zender.phone_admin.number'|trans }}</th>
                                    <th>{{ 'mautic.zender.phone_admin.connection'|trans }}</th>
                                    <th>{{ 'mautic.zender.phone_admin.enablement'|trans }}</th>
                                    <th class="text-right">{{ 'mautic.zender.phone_admin.pending'|trans }}</th>
                                    <th class="text-right">{{ 'mautic.zender.phone_admin.today_limit'|trans }}</th>
                                    <th class="text-right">{{ 'mautic.zender.phone_admin.available'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for account in dashboard.accounts|default([]) %}
                                    <tr data-phone-account-row="{{ account.account_hash }}"
                                        data-phone-account-enabled="{{ account.enabled ? 'true' : 'false' }}">
                                        <td>{{ account.dispatch_order }}</td>
                                        <td class="zpa-account-name">
                                            <strong>{{ account.label }}</strong>
                                            <small>
                                                Ref. {{ account.account_hash }}
                                            </small>
                                        </td>
                                        <td>
                                            <span class="text-monospace">
                                                {{
                                                    account.live_phone
                                                    ?: account.configured_phone
                                                    ?: ('mautic.zender.phone_admin.not_reported'|trans)
                                                }}
                                            </span>
                                        </td>
                                        <td>
                                            {% if account.live_status == 'connected' %}
                                                <span class="label label-success">
                                                    {{ 'mautic.zender.phone_admin.connected'|trans }}
                                                </span>
                                            {% elseif account.live_found %}
                                                <span class="label label-warning">
                                                    {{ account.live_status }}
                                                </span>
                                            {% else %}
                                                <span class="label label-danger">
                                                    {{ 'mautic.zender.phone_admin.not_found'|trans }}
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if account.enabled %}
                                                <span class="label label-success">
                                                    {{ 'mautic.zender.phone_admin.enabled'|trans }}
                                                </span>
                                            {% else %}
                                                <span class="label label-default">
                                                    {{ 'mautic.zender.phone_admin.disabled'|trans }}
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td class="text-right">
                                            {{ account.pending|default(0) }}
                                        </td>
                                        <td class="text-right">
                                            {{ account.dispatched_today|default(0) }}
                                            /
                                            {{ account.daily_limit|default(0) }}
                                        </td>
                                        <td class="text-right">
                                            <strong>
                                                {{ account.remaining_today|default(0) }}
                                            </strong>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="8"
                                            class="text-center text-muted pa-md"
                                            id="zender-phone-accounts-empty">
                                            {{ 'mautic.zender.phone_admin.no_accounts'|trans }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="panel-footer">
                        <p class="text-muted zpa-readonly-note">
                            {{ 'mautic.zender.phone_admin.connection_source_note'|trans }}
                            {{ 'mautic.zender.phone_admin.future_actions_note'|trans }}
                        </p>
                    </div>
                </div>
            </div>
        </div>

        {# PHASE_1D_PROTECTED_QUEUE_HISTORY_TABLE_V1 #}
        {% set queueHistory = queue_history|default({
            contract_version: 'queue_history_v1',
            items: [],
            limit: 10,
            offset: 0,
            has_more: false,
            next_offset: null,
            page: 1,
            page_size: 10,
            previous_page: null,
            next_page: null,
            from_record: 0,
            to_record: 0,
            filters: {},
            filter_query: {},
            filters_active: false,
            previous_query: null,
            next_query: null
        }) %}
        <div role="tabpanel"
             class="tab-pane{% if queueHistoryPaginationActive %} active{% endif %}"
             id="zender-tab-queue"
             aria-labelledby="zender-tab-queue-link">
            <div class="pa-md"
                 id="zender-queue-history"
                 data-zender-queue-history-stage="3-filter-controls"
                 data-zender-queue-history-contract="{{ queueHistory.contract_version }}"
                 data-zender-queue-history-count="{{ queueHistory.items|length }}"
                 data-zender-queue-history-page="{{ queueHistory.page }}"
                 data-zender-queue-history-filters-active="{{ queueHistory.filters_active ? 'true' : 'false' }}">
                <div class="panel panel-default">
                    {# PHASE_6_PER_PHONE_LOG #}
                    <div class="panel-heading">
                        <strong>{{ 'mautic.zender.phone_log.title'|trans }}</strong>
                        <span class="text-muted">
                            — {{ 'mautic.zender.phone_log.info'|trans }}
                        </span>
                    </div>
                    {# PHASE_1F4_TWIG_FILTER_CONTROLS_V1 #}
                    {% set queueFilterQuery =
                        queueHistory.filter_query|default({})
                    %}
                    <div class="panel-body zender-queue-filter-panel">
                        <style>
                            #zender-queue-history .zender-queue-filter-grid {
                                display: grid;
                                grid-template-columns:
                                    repeat(4, minmax(150px, 1fr));
                                gap: 12px;
                                align-items: end;
                            }
                            #zender-queue-history .zender-queue-filter-actions {
                                display: flex;
                                gap: 8px;
                                flex-wrap: wrap;
                            }
                            #zender-queue-history .zender-queue-filter-state {
                                margin-top: 10px;
                            }
                            @media (max-width: 1100px) {
                                #zender-queue-history
                                .zender-queue-filter-grid {
                                    grid-template-columns:
                                        repeat(2, minmax(150px, 1fr));
                                }
                            }
                            @media (max-width: 640px) {
                                #zender-queue-history
                                .zender-queue-filter-grid {
                                    grid-template-columns: 1fr;
                                }
                            }
                        </style>

                        <form method="get"
                              action="{{ path(
                                  'mautic_zender_control_index'
                              ) }}#zender-tab-queue"
                              id="zender-queue-history-filter-form"
                              autocomplete="off">
                            <div class="zender-queue-filter-grid">
                                <div class="form-group mb-0">
                                    <label for="zender-queue-filter-status">
                                        Status
                                    </label>
                                    <input type="text"
                                           class="form-control"
                                           id="zender-queue-filter-status"
                                           name="queue_status"
                                           maxlength="64"
                                           value="{{ queueFilterQuery.queue_status|default('') }}"
                                           placeholder="dispatched">
                                </div>

                                <div class="form-group mb-0">
                                    <label for="zender-queue-filter-source">
                                        Source
                                    </label>
                                    <input type="text"
                                           class="form-control"
                                           id="zender-queue-filter-source"
                                           name="queue_source"
                                           maxlength="64"
                                           value="{{ queueFilterQuery.queue_source|default('') }}"
                                           placeholder="sms">
                                </div>

                                <div class="form-group mb-0">
                                    <label for="zender-queue-filter-contact">
                                        Contact ID
                                    </label>
                                    <input type="number"
                                           class="form-control"
                                           id="zender-queue-filter-contact"
                                           name="queue_contact"
                                           min="1"
                                           step="1"
                                           value="{{ queueFilterQuery.queue_contact|default('') }}">
                                </div>

                                <div class="form-group mb-0">
                                    <label for="zender-queue-filter-sms">
                                        SMS ID
                                    </label>
                                    <input type="number"
                                           class="form-control"
                                           id="zender-queue-filter-sms"
                                           name="queue_sms"
                                           min="1"
                                           step="1"
                                           value="{{ queueFilterQuery.queue_sms|default('') }}">
                                </div>

                                <div class="form-group mb-0">
                                    <label for="zender-queue-filter-account">
                                        {{ 'mautic.zender.phone_log.phone'|trans }}
                                    </label>
                                    <select class="form-control"
                                            id="zender-queue-filter-account"
                                            name="queue_account">
                                        <option value="">
                                            {{ 'mautic.zender.phone_log.all'|trans }}
                                        </option>
                                        {% for account in dashboard.accounts %}
                                            <option value="{{ account.account_hash }}"
                                                    {% if queueFilterQuery.queue_account|default('') == account.account_hash %}selected{% endif %}>
                                                {{ account.label }} · {{ account.phone_display }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>

                                <div class="form-group mb-0">
                                    <label for="zender-queue-filter-from">
                                        Queued from UTC
                                    </label>
                                    <input type="date"
                                           class="form-control"
                                           id="zender-queue-filter-from"
                                           name="queue_from"
                                           value="{{ queueFilterQuery.queue_from|default('') }}">
                                </div>

                                <div class="form-group mb-0">
                                    <label for="zender-queue-filter-to">
                                        Queued to UTC
                                    </label>
                                    <input type="date"
                                           class="form-control"
                                           id="zender-queue-filter-to"
                                           name="queue_to"
                                           value="{{ queueFilterQuery.queue_to|default('') }}">
                                </div>

                                <div class="zender-queue-filter-actions">
                                    <button type="submit"
                                            class="btn btn-primary"
                                            id="zender-queue-filter-apply">
                                        Apply filters
                                    </button>
                                    <a class="btn btn-default"
                                       id="zender-queue-filter-clear"
                                       href="{{ path(
                                           'mautic_zender_control_index'
                                       ) }}#zender-tab-queue">
                                        Clear
                                    </a>
                                </div>
                            </div>

                            <div class="zender-queue-filter-state">
                                {% if queueHistory.filters_active %}
                                    <span class="label label-info"
                                          id="zender-queue-filters-active">
                                        Filters active
                                    </span>
                                {% else %}
                                    <span class="text-muted"
                                          id="zender-queue-filters-inactive">
                                        No filters applied.
                                    </span>
                                {% endif %}

                                {% if queueFilterQuery.queue_account|default('') %}
                                    <span class="label label-success ml-5"
                                          id="zender-phone-log-selected">
                                        {{ 'mautic.zender.phone_log.selected'|trans }}:
                                        {% for account in dashboard.accounts %}
                                            {% if account.account_hash == queueFilterQuery.queue_account %}
                                                {{ account.label }} · {{ account.phone_display }}
                                            {% endif %}
                                        {% endfor %}
                                    </span>
                                {% endif %}
                            </div>
                        </form>
                    </div>

                    {# PHASE_4A1_VISIBLE_PROVIDER_TRACKING_SCREEN_EXTENSION_V1 #}
                    {% set providerSentCount = 0 %}
                    {% set providerMessageIdCount = 0 %}
                    {% set providerObservedCount = 0 %}
                    {% set providerPendingObservationCount = 0 %}
                    {% for providerRow in queueHistory.items %}
                        {% set providerRowStatus =
                            providerRow.provider_status|default('not_reported')
                        %}
                        {% if providerRowStatus in [
                            'zender_sent',
                            'sent'
                        ] %}
                            {% set providerSentCount = providerSentCount + 1 %}
                        {% endif %}
                        {% if providerRow.has_provider_message_id %}
                            {% set providerMessageIdCount = providerMessageIdCount + 1 %}
                        {% endif %}
                        {% if providerRow.has_provider_status_observation %}
                            {% set providerObservedCount = providerObservedCount + 1 %}
                        {% elseif providerRow.status == 'dispatched' %}
                            {% set providerPendingObservationCount =
                                providerPendingObservationCount + 1
                            %}
                        {% endif %}
                    {% endfor %}

                    <div class="panel panel-default"
                         id="zender-provider-tracking-summary"
                         data-zender-provider-tracking-stage="4a1-visible-v1"
                         data-provider-sent="{{ providerSentCount }}"
                         data-provider-message-ids="{{ providerMessageIdCount }}"
                         data-provider-observed="{{ providerObservedCount }}"
                         data-provider-pending-observation="{{ providerPendingObservationCount }}">
                        <div class="panel-heading">
                            <h3 class="panel-title">{{ 'mautic.zender.tracking.title'|trans }}</h3>
                        </div>
                        <div class="panel-body">
                            <div class="alert alert-info">
                                {{ 'mautic.zender.tracking.explanation'|trans }}
                            </div>
                            <div class="row">
                                <div class="col-sm-6 col-md-3">
                                    <div class="panel panel-success mb-0">
                                        <div class="panel-body text-center">
                                            <div class="h2 mb-0">
                                                {{ providerSentCount }}
                                            </div>
                                            <small>{{ 'mautic.zender.tracking.sent_summary'|trans }}</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-md-3">
                                    <div class="panel panel-info mb-0">
                                        <div class="panel-body text-center">
                                            <div class="h2 mb-0">
                                                {{ providerMessageIdCount }}
                                            </div>
                                            <small>{{ 'mautic.zender.tracking.provider_message_id_summary'|trans }}</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-md-3">
                                    <div class="panel panel-primary mb-0">
                                        <div class="panel-body text-center">
                                            <div class="h2 mb-0">
                                                {{ providerObservedCount }}
                                            </div>
                                            <small>{{ 'mautic.zender.tracking.observed_summary'|trans }}</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-md-3">
                                    <div class="panel panel-warning mb-0">
                                        <div class="panel-body text-center">
                                            <div class="h2 mb-0">
                                                {{ providerPendingObservationCount }}
                                            </div>
                                            <small>{{ 'mautic.zender.tracking.pending_observation_summary'|trans }}</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="panel-body">
                        <p class="text-muted mb-0">
                            {{ 'mautic.zender.tracking.compact_explanation'|trans }}
                            {{ 'mautic.zender.tracking.page_summary'|trans({
                                '%page%': queueHistory.page,
                                '%from%': queueHistory.from_record,
                                '%to%': queueHistory.to_record,
                                '%count%': queueHistory.items|length,
                                '%size%': queueHistory.page_size
                            }) }}
                        </p>
                    </div>

                    {% if queueHistory.items is not empty %}
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0"
                                   id="zender-queue-history-table">
                                <thead>
                                    <tr>
                                        <th>{{ 'mautic.zender.tracking.table.queue'|trans }}</th>
                                        <th>{{ 'mautic.zender.tracking.table.contact'|trans }}</th>
                                        <th>{{ 'mautic.zender.tracking.table.sms'|trans }}</th>
                                        <th>{{ 'mautic.zender.tracking.table.source'|trans }}</th>
                                        <th>{{ 'mautic.zender.tracking.table.status'|trans }}</th>
                                        <th>{{ 'mautic.zender.tracking.table.account'|trans }}</th>
                                        <th>{{ 'mautic.zender.tracking.table.attempts'|trans }}</th>
                                        <th>{{ 'mautic.zender.tracking.table.queued_utc'|trans }}</th>
                                        <th>{{ 'mautic.zender.tracking.table.dispatched_utc'|trans }}</th>
                                        <th>{{ 'mautic.zender.tracking.table.provider'|trans }}</th>
                                        <th>{{ 'mautic.zender.tracking.table.evidence'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for row in queueHistory.items %}
                                        <tr data-queue-history-row="{{ row.id }}">
                                            <td>
                                                <strong>#{{ row.id }}</strong>
                                            </td>
                                            <td>{{ row.contact_id }}</td>
                                            <td>
                                                {{ row.sms_id is not null
                                                    ? row.sms_id
                                                    : '—'
                                                }}
                                            </td>
                                            <td>
                                                <code>{{ row.source }}</code>
                                                {% if row.source_id is not null %}
                                                    <br>
                                                    <small class="text-muted">
                                                        #{{ row.source_id }}
                                                    </small>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <span class="label label-default">
                                                    {{ row.status }}
                                                </span>
                                            </td>
                                            <td>
                                                {% if row.account_hash %}
                                                    {% for account in dashboard.accounts %}
                                                        {% if account.account_hash == row.account_hash %}
                                                            <strong>{{ account.label }}</strong><br>
                                                            <small class="text-muted">{{ account.phone_display }}</small><br>
                                                        {% endif %}
                                                    {% endfor %}
                                                    <code>{{ row.account_hash }}</code>
                                                {% else %}
                                                    <span class="text-muted">—</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ row.attempts }}</td>
                                            <td>
                                                {{ row.queued_at|default('—') }}
                                            </td>
                                            <td>
                                                {{ row.dispatched_at|default('—') }}
                                            </td>
                                            <td data-provider-status="{{ row.provider_status }}">
                                                {% set providerStatus =
                                                    row.provider_status|default('not_reported')
                                                %}
                                                {% set providerLabel = providerStatus %}
                                                {% set providerClass = 'label-info' %}

                                                {% if providerStatus in [
                                                    'zender_sent',
                                                    'sent'
                                                ] %}
                                                    {% set providerLabel = ('mautic.zender.tracking.status.sent'|trans) %}
                                                    {% set providerClass = 'label-success' %}
                                                {% elseif providerStatus in [
                                                    'provider_accepted',
                                                    'legacy_status_200',
                                                    'legacy_status_success',
                                                    'registered',
                                                    'accepted'
                                                ] %}
                                                    {% set providerLabel = ('mautic.zender.tracking.status.api_accepted'|trans) %}
                                                    {% set providerClass = 'label-info' %}
                                                {% elseif providerStatus == 'zender_registered' %}
                                                    {% set providerLabel = ('mautic.zender.tracking.status.legacy_registered'|trans) %}
                                                    {% set providerClass = 'label-warning' %}
                                                {% elseif providerStatus == 'zender_queued' %}
                                                    {% set providerLabel = ('mautic.zender.tracking.status.queued'|trans) %}
                                                    {% set providerClass = 'label-warning' %}
                                                {% elseif providerStatus in [
                                                    'zender_failed',
                                                    'failed'
                                                ] %}
                                                    {% set providerLabel = ('mautic.zender.tracking.status.failed'|trans) %}
                                                    {% set providerClass = 'label-danger' %}
                                                {% elseif providerStatus == 'zender_stuck_timeout' %}
                                                    {% set providerLabel = ('mautic.zender.tracking.status.stuck'|trans) %}
                                                    {% set providerClass = 'label-danger' %}
                                                {% elseif providerStatus == 'zender_status_unknown' %}
                                                    {% set providerLabel = ('mautic.zender.tracking.status.unknown'|trans) %}
                                                    {% set providerClass = 'label-warning' %}
                                                {% elseif providerStatus == 'not_reported' %}
                                                    {% set providerLabel = ('mautic.zender.tracking.status.not_observed'|trans) %}
                                                    {% set providerClass = 'label-default' %}
                                                {% endif %}

                                                <span class="label {{ providerClass }}">
                                                    {{ providerLabel }}
                                                </span>
                                                <br>
                                                <small class="text-muted">
                                                    {{ 'mautic.zender.tracking.technical_status'|trans }}:
                                                    <code>{{ providerStatus }}</code>
                                                </small>

                                                {% if row.provider_accepted_at %}
                                                    <br>
                                                    <small class="text-muted">
                                                        {{ 'mautic.zender.tracking.api_accepted_at'|trans }}:
                                                        {{ row.provider_accepted_at }}
                                                    </small>
                                                {% endif %}

                                                {% if row.provider_status_observed_at %}
                                                    <br>
                                                    <small class="text-muted">
                                                        {{ 'mautic.zender.tracking.observed_at'|trans }}:
                                                        {{ row.provider_status_observed_at }}
                                                    </small>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% set evidenceCount = 0 %}
                                                {% if row.has_stat_tracking_hash %}
                                                    {% set evidenceCount = evidenceCount + 1 %}
                                                    <span class="label label-info">
                                                        {{ 'mautic.zender.tracking.evidence.tracking'|trans }}
                                                    </span>
                                                {% endif %}
                                                {% if row.has_provider_message_id %}
                                                    {% set evidenceCount = evidenceCount + 1 %}
                                                    <span class="label label-info">
                                                        {{ 'mautic.zender.tracking.evidence.message_id'|trans }}
                                                    </span>
                                                {% endif %}
                                                {% if row.has_provider_response_sha256 %}
                                                    {% set evidenceCount = evidenceCount + 1 %}
                                                    <span class="label label-info">
                                                        {{ 'mautic.zender.tracking.evidence.response'|trans }}
                                                    </span>
                                                {% endif %}
                                                {% if row.has_provider_status_observation %}
                                                    {% set evidenceCount = evidenceCount + 1 %}
                                                    <span class="label label-info">
                                                        {{ 'mautic.zender.tracking.evidence.observed'|trans }}
                                                    </span>
                                                {% endif %}
                                                {% if row.has_error %}
                                                    {% set evidenceCount = evidenceCount + 1 %}
                                                    <span class="label label-danger">
                                                        {{ 'mautic.zender.tracking.evidence.error'|trans }}
                                                        {% if row.error_fingerprint %}
                                                            {{ row.error_fingerprint }}
                                                        {% endif %}
                                                    </span>
                                                {% endif %}
                                                {% if evidenceCount == 0 %}
                                                    <span class="text-muted">—</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="panel-body"
                             id="zender-queue-history-empty">
                            <p class="text-muted mb-0">
                                {{ 'mautic.zender.tracking.empty'|trans }}
                            </p>
                        </div>
                    {% endif %}

                    <div class="panel-footer clearfix"
                         id="zender-queue-history-pagination"
                         data-queue-history-page="{{ queueHistory.page }}">
                        <span class="pull-left text-muted">
                            {{ 'mautic.zender.tracking.pagination.summary'|trans({
                                '%page%': queueHistory.page,
