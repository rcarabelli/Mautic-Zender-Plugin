                <script>
                document.addEventListener('DOMContentLoaded', function () {
                    var button = document.getElementById('zender-ai-load-models');
                    var provider = document.getElementById('zender-ai-provider');
                    var model = document.getElementById('zender-ai-model');
                    var status = document.getElementById('zender-ai-model-status');

                    if (!button || !provider || !model || !status) {
                        return;
                    }

                    button.addEventListener('click', function () {
                        var selectedProvider = provider.value;
                        var keyField = document.getElementById('zender-ai-key-' + selectedProvider);
                        var formData = new FormData();

                        formData.append('_token', '{{ ai_settings_csrf_token|e('js') }}');
                        formData.append('provider', selectedProvider);
                        formData.append('api_key', keyField ? keyField.value : '');

                        button.disabled = true;
                        status.textContent = '{{ 'mautic.zender.ai.settings.loading_models'|trans|e('js') }}';

                        fetch('{{ path('mautic_zender_ai_models') }}', {
                            method: 'POST',
                            body: formData,
                            credentials: 'same-origin'
                        })
                        .then(function (response) { return response.json(); })
                        .then(function (payload) {
                            if (!payload.ok) {
                                throw new Error(payload.error || 'provider_error');
                            }

                            model.innerHTML = '';
                            payload.models.forEach(function (modelId) {
                                var option = document.createElement('option');
                                option.value = modelId;
                                option.textContent = modelId;
                                model.appendChild(option);
                            });

                            status.textContent = payload.models.length
                                + ' {{ 'mautic.zender.ai.settings.models_loaded'|trans|e('js') }}';
                        })
                        .catch(function () {
                            status.textContent = '{{ 'mautic.zender.ai.settings.models_error'|trans|e('js') }}';
                        })
                        .finally(function () {
                            button.disabled = false;
                        });
                    });
                });
                </script>
            </div>
        </div>

        {% set whatsappCampaigns = whatsapp_campaigns|default([]) %}
        <div role="tabpanel"
             class="tab-pane{% if whatsappCampaignsActive %} active{% endif %}"
             id="zender-tab-whatsapp-campaigns"
             aria-labelledby="zender-tab-whatsapp-campaigns-link">
            <div class="pa-md"
                 id="zender-whatsapp-campaign-status-tab">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <strong>
                            {{ 'mautic.zender.whatsapp.campaign_tab.title'|trans }}
                        </strong>
                        <span class="pull-right label label-info">
                            {{ whatsappCampaigns|length }}
                        </span>
                    </div>
                    <div class="panel-body">
                        <p class="text-muted mb-0">
                            {{ 'mautic.zender.whatsapp.campaign_tab.note'|trans }}
                        </p>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>{{ 'mautic.zender.whatsapp.campaign_tab.column.campaign'|trans }}</th>
                                    <th class="text-center">{{ 'mautic.zender.whatsapp.campaign_tab.column.total'|trans }}</th>
                                    <th class="text-center">{{ 'mautic.zender.whatsapp.campaign_status.filter.sent_by_zender'|trans }}</th>
                                    <th class="text-center">{{ 'mautic.zender.whatsapp.campaign_status.filter.held'|trans }}</th>
                                    <th class="text-center">{{ 'mautic.zender.whatsapp.campaign_status.filter.queued'|trans }}</th>
                                    <th class="text-center">{{ 'mautic.zender.whatsapp.campaign_status.filter.retry_pending'|trans }}</th>
                                    <th class="text-center">{{ 'mautic.zender.whatsapp.campaign_status.filter.failed'|trans }}</th>
                                    <th>{{ 'mautic.zender.whatsapp.campaign_tab.column.last_activity'|trans }}</th>
                                    <th class="text-right">{{ 'mautic.zender.whatsapp.campaign_tab.column.action'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for campaign in whatsappCampaigns %}
                                    <tr data-campaign-id="{{ campaign.campaign_id }}">
                                        <td>
                                            <strong>{{ campaign.campaign_name }}</strong>
                                            <br>
                                            <small class="text-muted">#{{ campaign.campaign_id }}</small>
                                        </td>
                                        <td class="text-center"><span class="label label-info">{{ campaign.all }}</span></td>
                                        <td class="text-center"><span class="label label-success">{{ campaign.sent_by_zender }}</span></td>
                                        <td class="text-center"><span class="label label-warning">{{ campaign.held }}</span></td>
                                        <td class="text-center"><span class="label label-info">{{ campaign.queued }}</span></td>
                                        <td class="text-center"><span class="label label-warning">{{ campaign.retry_pending }}</span></td>
                                        <td class="text-center"><span class="label label-danger">{{ campaign.failed }}</span></td>
                                        <td>
                                            {{ campaign.last_activity_at ? campaign.last_activity_at|date('Y-m-d H:i') : '—' }}
                                        </td>
                                        <td class="text-right">
                                            <a class="btn btn-default btn-sm"
                                               href="{{ path('mautic_zender_campaign_whatsapp_status', {'campaignId': campaign.campaign_id}) }}">
                                                <i class="ri-list-check-2"></i>
                                                {{ 'mautic.zender.whatsapp.campaign_tab.view_contacts'|trans }}
                                            </a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="9" class="text-center text-muted pa-md">
                                            {{ 'mautic.zender.whatsapp.campaign_tab.empty'|trans }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

<div role="tabpanel"
             class="tab-pane{% if not queueHistoryPaginationActive and not zenderSettingsTabActive and not receivedChatsActive and not whatsappCampaignsActive %} active{% endif %}"
             id="zender-tab-diagnostics"
             aria-labelledby="zender-tab-diagnostics-link">

            <div id="zender-phone-account-admin"
                 class="pa-md"
                 data-dashboard-marker="{{ dashboard.marker }}">
                <div class="alert alert-info">
                    <strong>{{ 'mautic.zender.readonly.title'|trans }}</strong>
                    {{ 'mautic.zender.readonly.body'|trans }}
                    <span class="pull-right">
                        {{ 'mautic.zender.checked'|trans }}:
                        {{ dashboard.live.checked_at_utc ?: dashboard.generated_at_utc }}
                    </span>
                </div>

                {% if not dashboard.live.available %}
                    <div class="alert alert-danger">
                        <strong>{{ 'mautic.zender.api.unavailable'|trans }}</strong>
                        {{ 'mautic.zender.code'|trans }}:
                        <code>{{ dashboard.live.error_code ?: 'unknown' }}</code>
                        · HTTP {{ dashboard.live.http_status }}
                    </div>
                {% endif %}

                {# PHASE_7_DIAGNOSTICS_SUMMARY #}
                {% set diagnosticsAttention =
                    (not dashboard.live.available)
                    or (not dashboard.config.enabled)
                    or (dashboard.live.managed_disconnected > 0)
                    or (dashboard.queue.failed > 0)
                %}

                <div id="zender-diagnostics-summary"
                     class="panel {{ diagnosticsAttention ? 'panel-warning' : 'panel-success' }}">
                    <div class="panel-heading">
                        <strong>{{ 'mautic.zender.tab.diagnostics'|trans }}</strong>
                        <span class="pull-right">
                            {{
                                diagnosticsAttention
                                ? ('mautic.zender.unavailable'|trans)
                                : ('mautic.zender.available'|trans)
                            }}
                        </span>
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-md-3 col-sm-6">
                                <strong>{{ 'mautic.zender.api.accounts'|trans }}</strong><br>
                                {{
                                    dashboard.live.available
                                    ? ('mautic.zender.available'|trans)
                                    : ('mautic.zender.unavailable'|trans)
                                }}
                                · HTTP {{ dashboard.live.http_status }}
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <strong>{{ 'mautic.zender.controlled.dispatch'|trans }}</strong><br>
                                {{
                                    dashboard.config.enabled
                                    ? ('mautic.zender.active'|trans)
                                    : ('mautic.zender.stopped'|trans)
                                }}
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <strong>{{ 'mautic.zender.managed.accounts'|trans }}</strong><br>
                                {{ dashboard.live.managed_connected }}
                                /
                                {{ dashboard.accounts_total }}
                                {{ 'mautic.zender.connected.plural'|trans }}
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <strong>{{ 'mautic.zender.current.queue'|trans }}</strong><br>
                                {{ dashboard.queue.pending }}
                                {{ 'mautic.zender.pending'|trans }}
                                ·
                                {{ dashboard.queue.failed }}
                                {{ 'mautic.zender.failed'|trans }}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-6">
                        <div class="panel {{ dashboard.live.available ? 'panel-success' : 'panel-danger' }}">
                            <div class="panel-heading">{{ 'mautic.zender.api.accounts'|trans }}</div>
                            <div class="panel-body">
                                <h2 class="mt-0">
                                    {{ dashboard.live.available ? ('mautic.zender.available'|trans) : ('mautic.zender.unavailable'|trans) }}
                                </h2>
                                <p>
                                    {{ dashboard.live.api_account_count }}
                                    {{ 'mautic.zender.accounts.returned'|trans }}
                                    {% if dashboard.live.api_host %}
                                        · {{ dashboard.live.api_host }}
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="panel panel-default">
                            <div class="panel-heading">{{ 'mautic.zender.managed.accounts'|trans }}</div>
                            <div class="panel-body">
                                <h2 class="mt-0">
                                    {{ dashboard.live.managed_matched }}
                                    /
                                    {{ dashboard.accounts_total }}
                                </h2>
                                <p>{{ 'mautic.zender.correlated'|trans }}</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="panel {{ dashboard.live.managed_disconnected > 0 ? 'panel-warning' : 'panel-success' }}">
                            <div class="panel-heading">{{ 'mautic.zender.whatsapp.connection'|trans }}</div>
                            <div class="panel-body">
                                <h2 class="mt-0">
                                    {{ dashboard.live.managed_connected }}
                                </h2>
                                <p>
                                    {{ 'mautic.zender.connected.plural'|trans }} ·
                                    {{ dashboard.live.managed_disconnected }}
                                    {{ 'mautic.zender.disconnected.plural'|trans }}
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="panel {{ dashboard.live.unmanaged_count > 0 ? 'panel-warning' : 'panel-default' }}">
                            <div class="panel-heading">{{ 'mautic.zender.outside.dispatcher'|trans }}</div>
                            <div class="panel-body">
                                <h2 class="mt-0">
                                    {{ dashboard.live.unmanaged_count }}
                                </h2>
                                <p>{{ 'mautic.zender.only.zender'|trans }}</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading">
                        <strong>{{ 'mautic.zender.accounts.phones'|trans }}</strong>
                        <span class="pull-right text-muted">
                            {{ 'mautic.zender.token'|trans }}:
                            {% if dashboard.live.token_fingerprint %}
                                <code>
                                    sha256:{{ dashboard.live.token_fingerprint }}
                                </code>
                            {% else %}
                                {{ 'mautic.zender.unavailable.lower'|trans }}
                            {% endif %}
                        </span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                            <tr>
                                <th>{{ 'mautic.zender.order'|trans }}</th>
                                <th>{{ 'mautic.zender.mautic.account'|trans }}</th>
                                <th>{{ 'mautic.zender.associated.number'|trans }}</th>
                                <th>{{ 'mautic.zender.zender.unique'|trans }}</th>
                                <th>{{ 'mautic.zender.connection'|trans }}</th>
                                <th>{{ 'mautic.zender.linked'|trans }}</th>
                                <th class="text-right">{{ 'mautic.zender.pending'|trans }}</th>
                                <th class="text-right">{{ 'mautic.zender.today.limit'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for account in dashboard.accounts %}
                                <tr>
                                    <td>{{ account.dispatch_order }}</td>
                                    <td>
                                        <strong>{{ account.label }}</strong><br>
                                        <small class="text-muted">
                                            {{ 'mautic.zender.reference'|trans }} {{ account.account_hash }}
                                            {% if account.live_match_basis %}
                                                · {{ 'mautic.zender.match'|trans }}
                                                {{ account.live_match_basis }}
                                            {% endif %}
                                        </small>
                                    </td>
                                    <td>
                                        <span class="text-monospace">
                                            {{
                                                account.live_phone
                                                ?: account.configured_phone
                                                ?: ('mautic.zender.unavailable'|trans)
                                            }}
                                        </span>
                                    </td>
                                    <td>
                                        {% if account.live_unique %}
                                            <code>{{ account.live_unique }}</code>
                                        {% else %}
                                            <span class="text-muted">
                                                {{ 'mautic.zender.not.found'|trans }}
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if account.live_status == 'connected' %}
                                            <span class="label label-success">
                                                {{ 'mautic.zender.connected'|trans }}
                                            </span>
                                        {% elseif account.live_found %}
                                            <span class="label label-warning">
                                                {{ account.live_status }}
                                            </span>
                                        {% else %}
                                            <span class="label label-danger">
                                                {{ 'mautic.zender.not.found'|trans }}
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {{
                                            account.live_created_at_utc
                                            ?: ('mautic.zender.not.reported'|trans)
                                        }}
                                    </td>
                                    <td class="text-right">
                                        {{ account.pending }}
                                    </td>
                                    <td class="text-right">
                                        {{ account.dispatched_today }}
                                        /
                                        {{ account.daily_limit }}
                                        <br>
                                        <small class="text-muted">
                                            {{ account.remaining_today }}
                                            {{ 'mautic.zender.available.plural'|trans }}
                                        </small>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="8"
                                        class="text-center text-muted pa-md">
                                        {{ 'mautic.zender.no.accounts'|trans }}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {% if dashboard.live.unmanaged_accounts %}
                    <div class="panel panel-warning">
                        <div class="panel-heading">
                            <strong>
                                {{ 'mautic.zender.unmanaged'|trans }}
                            </strong>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                <tr>
                                    <th>{{ 'mautic.zender.number'|trans }}</th>
                                    <th>{{ 'mautic.zender.unique.id'|trans }}</th>
                                    <th>{{ 'mautic.zender.status'|trans }}</th>
                                    <th>{{ 'mautic.zender.linked'|trans }}</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for account in dashboard.live.unmanaged_accounts %}
                                    <tr>
                                        <td>
                                            {{ account.phone ?: ('mautic.zender.not.reported'|trans) }}
                                        </td>
                                        <td>
                                            <code>{{ account.unique }}</code>
                                        </td>
                                        <td>
                                            <span class="label {{ account.status == 'connected' ? 'label-success' : 'label-warning' }}">
                                                {{ account.status }}
                                            </span>
                                        </td>
                                        <td>
                                            {{
                                                account.created_at_utc
                                                ?: ('mautic.zender.not.reported'|trans)
                                            }}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endif %}

                <div class="row">
                    <div class="col-md-4">
                        <div class="panel {{ dashboard.config.enabled ? 'panel-success' : 'panel-danger' }}">
                            <div class="panel-heading">
                                <strong>{{ 'mautic.zender.controlled.dispatch'|trans }}</strong>
                            </div>
                            <div class="panel-body">
                                <h3 class="mt-0">
                                    {{
                                        dashboard.config.enabled
                                        ? ('mautic.zender.active'|trans)
                                        : ('mautic.zender.stopped'|trans)
                                    }}
                                </h3>
                                <p>
                                    {{ dashboard.config.window_start }}
                                    –
                                    {{ dashboard.config.window_end }}
                                    ·
                                    {{ dashboard.config.timezone }}
                                </p>
                                <dl class="dl-horizontal mb-0">
                                    <dt>{{ 'mautic.zender.global.limit'|trans }}</dt>
                                    <dd>
                                        {{ dashboard.config.global_daily_limit }}
                                    </dd>
                                    <dt>{{ 'mautic.zender.account.limit'|trans }}</dt>
                                    <dd>
                                        {{
                                            dashboard.config
                                                .per_account_daily_limit
                                        }}
                                    </dd>
                                    <dt>{{ 'mautic.zender.batch'|trans }}</dt>
                                    <dd>{{ dashboard.config.batch_size }}</dd>
                                    <dt>{{ 'mautic.zender.retries'|trans }}</dt>
                                    <dd>{{ dashboard.config.max_attempts }}</dd>
                                </dl>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <strong>{{ 'mautic.zender.current.queue'|trans }}</strong>
                            </div>
                            <div class="panel-body">
                                <dl class="dl-horizontal mb-0">
                                    <dt>{{ 'mautic.zender.pending'|trans }}</dt>
                                    <dd>{{ dashboard.queue.pending }}</dd>
                                    <dt>{{ 'mautic.zender.dispatching'|trans }}</dt>
                                    <dd>{{ dashboard.queue.dispatching }}</dd>
                                    <dt>{{ 'mautic.zender.dispatched'|trans }}</dt>
                                    <dd>{{ dashboard.queue.dispatched }}</dd>
                                    <dt>{{ 'mautic.zender.failed'|trans }}</dt>
                                    <dd>{{ dashboard.queue.failed }}</dd>
                                    <dt>{{ 'mautic.zender.other'|trans }}</dt>
                                    <dd>{{ dashboard.queue.other }}</dd>
                                    <dt>{{ 'mautic.zender.total'|trans }}</dt>
                                    <dd>
                                        <strong>{{ dashboard.queue.total }}</strong>
                                    </dd>
                                </dl>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <strong>{{ 'mautic.zender.today.usage'|trans }}</strong>
                            </div>
                            <div class="panel-body">
                                <h3 class="mt-0">
                                    {{ dashboard.today.dispatched }}
                                </h3>
                                <p>{{ 'mautic.zender.messages.dispatched'|trans }}</p>
                                <dl class="dl-horizontal mb-0">
                                    <dt>{{ 'mautic.zender.global.capacity'|trans }}</dt>
                                    <dd>{{ dashboard.today.global_limit }}</dd>
                                    <dt>{{ 'mautic.zender.available'|trans }}</dt>
                                    <dd>
                                        {{ dashboard.today.remaining_global }}
                                    </dd>
                                    <dt>{{ 'mautic.zender.api.query'|trans }}</dt>
                                    <dd>
                                        {{ dashboard.safety.provider_calls }}
                                        {{ 'mautic.zender.readonly.request'|trans }}
                                    </dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="well well-sm text-muted">
                    <code>{{ dashboard.marker }}</code>
                    · MauticZenderBundle {{ plugin_version }}
                    · {{ 'mautic.zender.footer'|trans }}
                </div>
            </div>
        </div>
    </div>

<footer
    id="zender-control-brand-signature"
    aria-label="7 Cats Studio">
    <a
        class="zender-control-brand-signature-link"
        href="https://www.7catstudio.com/"
        target="_blank"
        rel="noopener noreferrer"
        title="7 Cats Studio">
        <img
            class="zender-control-brand-signature-logo zender-control-brand-signature-logo-wide"
            src="data:image/png;base64,"
            alt="7 Cats Studio"
        >
        <img
            class="zender-control-brand-signature-logo zender-control-brand-signature-logo-mark"
            src="data:image/png;base64,"
            alt="7 Cats Studio"
        >
    </a>
</footer>
</div>
{% endblock %}

