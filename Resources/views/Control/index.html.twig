        {# RECEIVED_CHAT_VISIBLE_4B2B_V1 #}
        {% set receivedChats = received_chats|default({
            items: [],
            summary: {
                total: 0,
                unique: 0,
                ambiguous: 0,
                unmatched: 0,
                unmatchable: 0
            },
            page: 1,
            page_size: 25,
            page_count: 1,
            previous_page: null,
            next_page: null,
            from_record: 0,
            to_record: 0
        }) %}
        <div role="tabpanel"
             class="tab-pane{% if receivedChatsActive %} active{% endif %}"
             id="zender-tab-received"
             aria-labelledby="zender-tab-received-link">
            <div class="pa-md zender-received-workspace"
                 id="zender-received-workspace"
                 data-zender-received-stage="4b2b-visible-read-only"
                 data-zender-received-total="{{ receivedChats.summary.total }}"
                 data-zender-received-page="{{ receivedChats.page }}">
                <style>
                    #zender-received-workspace {
                        --zrc-border: #dfe3ea;
                        --zrc-muted: #6b7280;
                        --zrc-soft: #f7f9fc;
                        --zrc-radius: 14px;
                    }
                    #zender-received-workspace * {
                        box-sizing: border-box;
                    }
                    #zender-received-workspace .zrc-shell {
                        display: flex;
                        flex-direction: column;
                        gap: 16px;
                    }
                    #zender-received-workspace .zrc-summary {
                        display: grid;
                        grid-template-columns: repeat(5, minmax(0, 1fr));
                        gap: 12px;
                    }
                    #zender-received-workspace .zrc-summary-card {
                        padding: 16px;
                        border: 1px solid var(--zrc-border);
                        border-radius: var(--zrc-radius);
                        background: #fff;
                    }
                    #zender-received-workspace .zrc-summary-card strong {
                        display: block;
                        margin-top: 5px;
                        font-size: 24px;
                        line-height: 1.1;
                    }
                    #zender-received-workspace .zrc-summary-card span {
                        color: var(--zrc-muted);
                        font-size: 12px;
                        text-transform: uppercase;
                        letter-spacing: .04em;
                    }
                    #zender-received-workspace .zrc-message {
                        max-width: 480px;
                        white-space: pre-wrap;
                        overflow-wrap: anywhere;
                    }
                    #zender-received-workspace .zrc-meta {
                        display: flex;
                        flex-wrap: wrap;
                        gap: 5px 10px;
                        margin-top: 6px;
                        color: var(--zrc-muted);
                        font-size: 12px;
                    }
                    #zender-received-workspace .zrc-contact strong,
                    #zender-received-workspace .zrc-contact small {
                        display: block;
                    }
                    #zender-received-workspace .zrc-empty {
                        padding: 34px 18px;
                        text-align: center;
                        color: var(--zrc-muted);
                    }
                    #zender-received-workspace .panel-footer {
                        line-height: 34px;
                    }
                    @media (max-width: 1199px) {
                        #zender-received-workspace .zrc-summary {
                            grid-template-columns: repeat(3, minmax(0, 1fr));
                        }
                    }
                    @media (max-width: 767px) {
                        #zender-received-workspace {
                            padding: 12px;
                        }
                        #zender-received-workspace .zrc-summary {
                            grid-template-columns: 1fr;
                        }
                        #zender-received-workspace .panel-footer .pull-left,
                        #zender-received-workspace .panel-footer .pull-right {
                            float: none !important;
                            display: block;
                        }
                        #zender-received-workspace .panel-footer .btn-group {
                            margin-top: 8px;
                        }
                    }
                </style>

                <div class="zrc-shell">
                    <div class="alert alert-info mb-0"
                         id="zender-received-readonly">
                        <strong>{{ 'mautic.zender.received.title'|trans }}</strong>
                        {{ 'mautic.zender.received.readonly'|trans }}
                    </div>

                    <div class="zrc-summary"
                         id="zender-received-summary">
                        <div class="zrc-summary-card">
                            <span>{{ 'mautic.zender.received.summary.total'|trans }}</span>
                            <strong id="zender-received-total">{{ receivedChats.summary.total }}</strong>
                        </div>
                        <div class="zrc-summary-card">
                            <span>{{ 'mautic.zender.received.summary.unique'|trans }}</span>
                            <strong id="zender-received-unique">{{ receivedChats.summary.unique }}</strong>
                        </div>
                        <div class="zrc-summary-card">
                            <span>{{ 'mautic.zender.received.summary.ambiguous'|trans }}</span>
                            <strong id="zender-received-ambiguous">{{ receivedChats.summary.ambiguous }}</strong>
                        </div>
                        <div class="zrc-summary-card">
                            <span>{{ 'mautic.zender.received.summary.unmatched'|trans }}</span>
                            <strong id="zender-received-unmatched">{{ receivedChats.summary.unmatched }}</strong>
                        </div>
                        <div class="zrc-summary-card">
                            <span>{{ 'mautic.zender.received.summary.unmatchable'|trans }}</span>
                            <strong id="zender-received-unmatchable">{{ receivedChats.summary.unmatchable }}</strong>
                        </div>
                    </div>

                    <div class="panel panel-default mb-0"
                         id="zender-received-panel">
                        <div class="panel-heading">
                            <strong>{{ 'mautic.zender.received.title'|trans }}</strong>
                            <p class="text-muted mb-0 mt-5">
                                {{ 'mautic.zender.received.subtitle'|trans }}
                            </p>
                        </div>

                        {% if receivedChats.items is not empty %}
                            <div class="table-responsive">
                                <table class="table table-hover table-striped mb-0"
                                       id="zender-received-table">
                                    <thead>
                                        <tr>
                                            <th>{{ 'mautic.zender.received.column.received_at'|trans }}</th>
                                            <th>{{ 'mautic.zender.received.column.contact'|trans }}</th>
                                            <th>{{ 'mautic.zender.received.column.sender'|trans }}</th>
                                            <th>{{ 'mautic.zender.received.column.account'|trans }}</th>
                                            <th>{{ 'mautic.zender.received.column.message'|trans }}</th>
                                            <th>{{ 'mautic.zender.received.column.match'|trans }}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    {% for chat in receivedChats.items %}
                                        <tr data-zender-received-row="{{ chat.id }}">
                                            <td>
                                                <span class="text-nowrap">
                                                    {{ chat.provider_created_at ?: '—' }}
                                                </span>
                                            </td>
                                            <td class="zrc-contact">
                                                <strong>
                                                    {{ chat.contact_label ?: ('mautic.zender.received.contact.none'|trans) }}
                                                </strong>
                                                {% if chat.contact_email %}
                                                    <small>{{ chat.contact_email }}</small>
                                                {% endif %}
                                                {% if chat.contact_id %}
                                                    <small>
                                                        {{ 'mautic.zender.received.contact.id'|trans }}
                                                        #{{ chat.contact_id }}
                                                    </small>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <code>{{ chat.sender_display ?: '—' }}</code>
                                            </td>
                                            <td>
                                                {% if chat.account_hash %}
                                                    <span class="text-muted">
                                                        {{ 'mautic.zender.received.account.reference'|trans }}:
                                                    </span>
                                                    <code>{{ chat.account_hash }}</code>
                                                {% else %}
                                                    <span class="text-muted">—</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <div class="zrc-message">
                                                    {{ chat.message_body ?: ('mautic.zender.received.message.empty'|trans) }}
                                                </div>
                                                <div class="zrc-meta">
                                                    <span>
                                                        {{ 'mautic.zender.received.message.type'|trans }}:
                                                        {{ chat.message_type ?: '—' }}
                                                    </span>
                                                    {% if chat.provider_received_id %}
                                                        <span>
                                                            {{ 'mautic.zender.received.provider_id'|trans }}:
                                                            {{ chat.provider_received_id }}
                                                        </span>
                                                    {% endif %}
                                                    {% if chat.has_attachment %}
                                                        <span class="label label-info">
                                                            {{ 'mautic.zender.received.attachment'|trans }}
                                                        </span>
                                                    {% endif %}
                                                </div>
                                            </td>
                                            <td>
                                                {% if chat.contact_match_state == 'unique_contact' %}
                                                    <span class="label label-success">
                                                        {{ 'mautic.zender.received.match.unique'|trans }}
                                                    </span>
                                                {% elseif chat.contact_match_state == 'ambiguous_contact' %}
                                                    <span class="label label-warning">
                                                        {{ 'mautic.zender.received.match.ambiguous'|trans }}
                                                    </span>
                                                {% elseif chat.contact_match_state == 'unmatchable_number' %}
                                                    <span class="label label-default">
                                                        {{ 'mautic.zender.received.match.unmatchable'|trans }}
                                                    </span>
                                                {% else %}
                                                    <span class="label label-danger">
                                                        {{ 'mautic.zender.received.match.unmatched'|trans }}
                                                    </span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <div class="zrc-empty"
                                 id="zender-received-empty">
                                {{ 'mautic.zender.received.no_messages'|trans }}
                            </div>
                        {% endif %}

                        <div class="panel-footer clearfix"
                             id="zender-received-pagination"
                             data-zender-received-page="{{ receivedChats.page }}">
                            <span class="pull-left text-muted">
                                {{ 'mautic.zender.received.page'|trans }}
                                {{ receivedChats.page }}
                                ·
                                {{ 'mautic.zender.received.records'|trans }}
                                {{ receivedChats.from_record }}–{{ receivedChats.to_record }}
                            </span>
                            <div class="btn-group pull-right"
                                 role="group"
                                 aria-label="{{ 'mautic.zender.received.pagination.aria'|trans }}">
                                {% if receivedChats.previous_page is not null %}
                                    <a class="btn btn-default"
                                       id="zender-received-previous"
                                       href="{{ path(
                                           'mautic_zender_control_index',
                                           {
                                               received_page: receivedChats.previous_page,
                                               received_tab: 1
                                           }
                                       ) }}#zender-tab-received">
                                        {{ 'mautic.zender.received.previous'|trans }}
                                    </a>
                                {% else %}
                                    <span class="btn btn-default disabled"
                                          id="zender-received-previous-disabled"
                                          aria-disabled="true">
                                        {{ 'mautic.zender.received.previous'|trans }}
                                    </span>
                                {% endif %}

                                {% if receivedChats.next_page is not null %}
                                    <a class="btn btn-default"
                                       id="zender-received-next"
                                       href="{{ path(
                                           'mautic_zender_control_index',
                                           {
                                               received_page: receivedChats.next_page,
                                               received_tab: 1
                                           }
                                       ) }}#zender-tab-received">
                                        {{ 'mautic.zender.received.next'|trans }}
                                    </a>
                                {% else %}
                                    <span class="btn btn-default disabled"
                                          id="zender-received-next-disabled"
                                          aria-disabled="true">
                                        {{ 'mautic.zender.received.next'|trans }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div role="tabpanel"
             class="tab-pane{% if zenderSettingsTabActive %} active{% endif %}"
             id="zender-tab-settings"
             aria-labelledby="zender-tab-settings-link">
            {% set zenderWindowStartParts = dashboard.config.window_start|split(':') %}
            {% set zenderWindowEndParts = dashboard.config.window_end|split(':') %}
            {% set zenderWindowStartSeconds =
                (zenderWindowStartParts[0]|default(0)|int * 3600)
                + (zenderWindowStartParts[1]|default(0)|int * 60)
            %}
            {% set zenderWindowEndSeconds =
                (zenderWindowEndParts[0]|default(0)|int * 3600)
                + (zenderWindowEndParts[1]|default(0)|int * 60)
            %}
            {% set zenderWindowSeconds =
                zenderWindowEndSeconds - zenderWindowStartSeconds
            %}
            {% if zenderWindowSeconds <= 0 %}
                {% set zenderWindowSeconds = zenderWindowSeconds + 86400 %}
            {% endif %}
            {% set zenderPreviewInterval =
                dashboard.config.dispatch_interval_seconds|default(165)|int
            %}
            {% if zenderPreviewInterval < 0 %}
                {% set zenderPreviewInterval = 0 %}
            {% endif %}
            {% set zenderPreviewCapacityDivisor =
                zenderPreviewInterval > 0
                ? zenderPreviewInterval
                : 1
            %}
            {% set zenderPreviewPerDevice =
                (zenderWindowSeconds / zenderPreviewCapacityDivisor)
                |round(0, 'floor')
            %}
            {% set zenderPreviewTotal = zenderPreviewPerDevice * dashboard.accounts_enabled %}

