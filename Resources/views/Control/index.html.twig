                                   ) }}#zender-tab-queue">
                                    {{ 'mautic.zender.tracking.pagination.previous'|trans }}
                                </a>
                            {% else %}
                                <span class="btn btn-default disabled"
                                      id="zender-queue-history-previous-disabled"
                                      aria-disabled="true">
                                    {{ 'mautic.zender.tracking.pagination.previous'|trans }}
                                </span>
                            {% endif %}

                            {% if queueHistory.next_page is not null %}
                                <a class="btn btn-default"
                                   id="zender-queue-history-next"
                                   href="{{ path(
                                       'mautic_zender_control_index',
                                       queueHistory.next_query|default({})
                                   ) }}#zender-tab-queue">
                                    {{ 'mautic.zender.tracking.pagination.next'|trans }}
                                </a>
                            {% else %}
                                <span class="btn btn-default disabled"
                                      id="zender-queue-history-next-disabled"
                                      aria-disabled="true">
                                    {{ 'mautic.zender.tracking.pagination.next'|trans }}
                                </span>
                            {% endif %}
