                    }
                    @media (max-width: 1199px) {
                        #zender-control-tabs .zender-settings-stage7 .zcs-config-section {
                            grid-template-columns: minmax(0, 1.7fr) minmax(250px, 1fr);
                        }
                        #zender-control-tabs .zender-settings-stage7 .zcs-section-two-up {
                            grid-template-columns: 1fr;
                        }
                    }
                    @media (max-width: 991px) {
                        #zender-control-tabs .zender-settings-stage7 .zcs-config-section {
                            grid-template-columns: 1fr;
                        }
                        #zender-control-tabs .zender-settings-stage7 .zcs-guide-card {
                            position: static;
                        }
                    }
                
                    /* SETTINGS_VISUAL_POLISH_V1_BEGIN */

                    /*
                     * Every section heading occupies the complete row.
                     * The controls and guidance begin together on the next row.
                     */
                    #zender-control-tabs .zender-settings-stage7
                    .zcs-config-section {
                        display: grid !important;
                        grid-template-columns:
                            minmax(0, 2fr)
                            minmax(270px, 1fr) !important;
                        column-gap: var(--zc-gap);
                        row-gap: 16px;
                        align-items: start;
                    }

                    #zender-control-tabs .zender-settings-stage7
                    .zcs-config-section > .zcs-section-main {
                        display: contents;
                    }

                    #zender-control-tabs .zender-settings-stage7
                    .zcs-config-section .zcs-section-heading {
                        grid-column: 1 / -1;
                        width: 100%;
                        margin-bottom: 0;
                    }

                    #zender-control-tabs .zender-settings-stage7
                    .zcs-config-section .zcs-section-content {
                        grid-column: 1;
                        min-width: 0;
                    }

                    #zender-control-tabs .zender-settings-stage7
                    .zcs-config-section .zcs-guide-card {
                        grid-column: 2;
                        align-self: start;
                        width: 100%;
                        min-width: 0;
                        margin-top: 10px;
                    }

                    /*
                     * Give the complete tab bar a visual container. Inactive
                     * tabs remain lighter than the selected tab.
                     */
                    #zender-control-tabs > .nav-tabs,
                    #zender-control-tab-list {
                        display: flex;
                        flex-wrap: wrap;
                        gap: 7px;
                        width: 100%;
                        margin: 0 0 18px;
                        padding: 7px;
                        border: 1px solid #e1e6ef;
                        border-radius: 13px;
                        background: #f4f6fa;
                        box-shadow:
                            inset 0 1px 0 rgba(255, 255, 255, .9),
                            0 3px 12px rgba(15, 23, 42, .06);
                    }

                    #zender-control-tabs > .nav-tabs > li,
                    #zender-control-tab-list > li {
                        float: none;
                        flex: 0 0 auto;
                        margin: 0;
                    }

                    #zender-control-tabs > .nav-tabs > li > a,
                    #zender-control-tab-list > li > a {
                        margin: 0;
                        padding: 9px 13px;
                        border: 1px solid #d9e0ea !important;
                        border-radius: 9px;
                        background: #ffffff;
                        color: #4b5563;
                        box-shadow:
                            0 1px 2px rgba(15, 23, 42, .07),
                            0 4px 10px rgba(15, 23, 42, .035);
                        transition:
                            background-color .16s ease,
                            border-color .16s ease,
                            color .16s ease,
                            box-shadow .16s ease,
                            transform .16s ease;
                    }

                    #zender-control-tabs > .nav-tabs > li > a:hover,
                    #zender-control-tabs > .nav-tabs > li > a:focus,
                    #zender-control-tab-list > li > a:hover,
                    #zender-control-tab-list > li > a:focus {
                        border-color: #bac5d5 !important;
                        background: #f9fafb;
                        color: #1f2937;
                        box-shadow:
                            0 2px 4px rgba(15, 23, 42, .08),
                            0 6px 14px rgba(15, 23, 42, .05);
                        transform: translateY(-1px);
                    }

                    #zender-control-tabs > .nav-tabs > li.active > a,
                    #zender-control-tabs > .nav-tabs > li.active > a:hover,
                    #zender-control-tabs > .nav-tabs > li.active > a:focus,
                    #zender-control-tab-list > li.active > a,
                    #zender-control-tab-list > li.active > a:hover,
                    #zender-control-tab-list > li.active > a:focus {
                        border-color: #4f5fae !important;
                        background: #5667b5;
                        color: #ffffff;
                        box-shadow:
                            0 3px 8px rgba(49, 63, 133, .22),
                            0 8px 18px rgba(49, 63, 133, .13);
                        transform: none;
                    }

                    /*
                     * Keep every configuration component inside the viewport.
                     */
                    #zender-control-tabs,
                    #zender-control-tabs .tab-content,
                    #zender-control-tabs .tab-pane,
                    #zender-control-tabs .zender-settings-stage7,
                    #zender-control-tabs .zcs-settings-v2,
                    #zender-control-tabs .zcs-shell,
                    #zender-control-tabs .zcs-config-section,
                    #zender-control-tabs .zcs-section-main,
                    #zender-control-tabs .zcs-section-content,
                    #zender-control-tabs .zcs-card,
                    #zender-control-tabs .zcs-ai-card,
                    #zender-control-tabs form,
                    #zender-control-tabs fieldset,
                    #zender-control-tabs .row,
                    #zender-control-tabs [class*="col-"] {
                        min-width: 0;
                        max-width: 100%;
                    }

                    #zender-control-tabs .zcs-card img,
                    #zender-control-tabs .zcs-card video,
                    #zender-control-tabs .zcs-card canvas,
                    #zender-control-tabs .zcs-card svg {
                        max-width: 100%;
                        height: auto;
                    }

                    #zender-control-tabs .zcs-card input,
                    #zender-control-tabs .zcs-card select,
                    #zender-control-tabs .zcs-card textarea,
                    #zender-control-tabs .zcs-card .form-control,
                    #zender-control-tabs .zcs-card .input-group {
                        max-width: 100%;
                        min-width: 0;
                    }

                    #zender-control-tabs .zcs-card .table-responsive,
                    #zender-control-tabs .zcs-card .zcs-table-wrap {
                        width: 100%;
                        max-width: 100%;
                        overflow-x: auto;
                        -webkit-overflow-scrolling: touch;
                    }

                    @media (max-width: 991px) {
                        #zender-control-tabs .zender-settings-stage7
                        .zcs-config-section {
                            grid-template-columns: minmax(0, 1fr) !important;
                            row-gap: 13px;
                        }

                        #zender-control-tabs .zender-settings-stage7
                        .zcs-config-section .zcs-section-heading,
                        #zender-control-tabs .zender-settings-stage7
                        .zcs-config-section .zcs-section-content,
                        #zender-control-tabs .zender-settings-stage7
                        .zcs-config-section .zcs-guide-card {
                            grid-column: 1;
                        }

                        #zender-control-tabs .zender-settings-stage7
                        .zcs-config-section .zcs-guide-card {
                            position: static;
                            margin-top: 0;
                        }
                    }

                    @media (max-width: 767px) {
                        #zender-control-tabs {
                            width: 100%;
                            max-width: 100%;
                            overflow-x: hidden;
                        }

                        #zender-control-tabs > .nav-tabs,
                        #zender-control-tab-list {
                            flex-wrap: nowrap;
                            gap: 6px;
                            width: 100%;
                            max-width: 100%;
                            padding: 6px;
                            overflow-x: auto;
                            overflow-y: hidden;
                            white-space: nowrap;
                            scrollbar-width: thin;
                            -webkit-overflow-scrolling: touch;
                        }

                        #zender-control-tabs > .nav-tabs > li,
                        #zender-control-tab-list > li {
                            display: block;
                            flex: 0 0 auto;
                        }

                        #zender-control-tabs > .nav-tabs > li > a,
                        #zender-control-tab-list > li > a {
                            display: block;
                            min-height: 38px;
                            padding: 9px 12px;
                        }

                        #zender-control-tabs .zender-settings-stage7 {
                            padding-left: 8px;
                            padding-right: 8px;
                        }

                        #zender-control-tabs .zcs-page-title {
                            font-size: 22px;
                        }

                        #zender-control-tabs .zcs-section-title {
                            font-size: 19px;
                        }

                        #zender-control-tabs .zcs-card {
                            width: 100%;
                            max-width: 100%;
                            overflow-x: auto;
                            -webkit-overflow-scrolling: touch;
                        }

                        #zender-control-tabs .zcs-card .row {
                            margin-left: -6px;
                            margin-right: -6px;
                        }

                        #zender-control-tabs .zcs-card [class*="col-"] {
                            width: 100%;
                            float: none;
                            padding-left: 6px;
                            padding-right: 6px;
                        }

                        #zender-ai-settings .input-group {
                            display: flex;
                            flex-direction: column;
                            align-items: stretch;
                            gap: 7px;
                            width: 100%;
                        }

                        #zender-ai-settings .input-group > .form-control,
                        #zender-ai-settings .input-group > .input-group-btn {
                            display: block;
                            width: 100%;
                        }

                        #zender-ai-settings .input-group-btn .btn {
                            width: 100%;
                            margin: 0;
                            border-radius: 6px;
                        }

                        #zender-control-tabs .zcs-card .btn {
                            max-width: 100%;
                            white-space: normal;
                        }

                        #zender-control-tabs .zcs-card table {
                            font-size: 12px;
                        }
                    }

                    /* SETTINGS_VISUAL_POLISH_V1_END */
</style>

                <div class="zcs-shell zcs-settings-v2">
<header class="zcs-page-header">
                        <h2 class="zcs-page-title">{{ 'mautic.zender.settings.page.title'|trans }}</h2>
                        <p class="zcs-page-subtitle">{{ 'mautic.zender.settings.page.subtitle'|trans }}</p>
                    </header>

                    <div class="zcs-summary">
                                            <div class="zcs-summary-card">
                                                <span class="zcs-summary-label">{{ 'mautic.zender.settings.interval.title'|trans }}</span>
                                                <span class="zcs-summary-value">{{ zenderPreviewInterval }}</span>
                                                <span class="zcs-summary-meta">{{ 'mautic.zender.settings.seconds'|trans }}</span>
                                            </div>
                                            <div class="zcs-summary-card">
                                                <span class="zcs-summary-label">{{ 'mautic.zender.settings.window.title'|trans }}</span>
                                                <span class="zcs-summary-value">{{ dashboard.config.window_start }}–{{ dashboard.config.window_end }}</span>
                                                <span class="zcs-summary-meta">{{ 'mautic.zender.settings.window.order_help'|trans }}</span>
                                            </div>
                                            <div class="zcs-summary-card">
                                                <span class="zcs-summary-label">{{ 'mautic.zender.settings.dispatcher.title'|trans }}</span>
                                                <span class="zcs-summary-value">{{ dashboard.config.enabled ? '●' : '○' }}</span>
                                                <span class="zcs-summary-meta">{{ 'mautic.zender.settings.dispatcher.help'|trans }}</span>
                                            </div>
                                            <div class="zcs-summary-card">
                                                <span class="zcs-summary-label">{{ 'mautic.zender.settings.accounts.title'|trans }}</span>
                                                <span class="zcs-summary-value">{{ dashboard.accounts_enabled }}</span>
                                                <span class="zcs-summary-meta">{{ 'mautic.zender.settings.accounts.help'|trans }}</span>
                                            </div>
                                        </div>

                    <div class="zcs-section-divider" aria-hidden="true"></div>

                    <section class="zcs-config-section" id="zender-settings-section-ai">
                        <div class="zcs-section-main">
                            <div class="zcs-section-heading">
                                <span class="zcs-section-kicker">{{ 'mautic.zender.settings.section.ai.kicker'|trans }}</span>
                                <h2 class="zcs-section-title">{{ 'mautic.zender.settings.section.ai.title'|trans }}</h2>
                                <p class="zcs-section-subtitle">{{ 'mautic.zender.settings.section.ai.subtitle'|trans }}</p>
                            </div>
                            <div class="zcs-section-content">
                                <div class="zcs-card zcs-ai-card" id="zender-ai-settings">
                    
                                                    <div class="zcs-ai-body">
                                                        {% if app.request.query.get('settings_saved') == 'ai_settings' %}
                                                            <div class="alert alert-success">{{ 'mautic.zender.ai.settings.saved'|trans }}</div>
                                                        {% endif %}

                                                        <p class="text-muted">{{ 'mautic.zender.ai.settings.info'|trans }}</p>

                                                        <form method="post"
                                                              action="{{ path('mautic_zender_control_index') }}"
                                                              id="zender-ai-settings-form"
                                                              autocomplete="off">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('mautic_zender_settings') }}">
                                                            <input type="hidden" name="settings_action" value="ai_settings">

                                                            <div class="row">
                                                                <div class="col-md-4">
                                                                    <div class="form-group">
                                                                        <label for="zender-ai-provider">{{ 'mautic.zender.ai.settings.provider'|trans }}</label>
                                                                        <select class="form-control" id="zender-ai-provider" name="active_provider" required>
                                                                            <option value="openai"{% if ai_settings.active_provider == 'openai' %} selected{% endif %}>OpenAI</option>
                                                                            <option value="anthropic"{% if ai_settings.active_provider == 'anthropic' %} selected{% endif %}>Claude / Anthropic</option>
                                                                            <option value="grok"{% if ai_settings.active_provider == 'grok' %} selected{% endif %}>Grok / xAI</option>
                                                                        </select>
                                                                    </div>
                                                                </div>

                                                                <div class="col-md-8">
                                                                    <div class="form-group">
                                                                        <label for="zender-ai-model">{{ 'mautic.zender.ai.settings.model'|trans }}</label>
                                                                        <div class="input-group">
                                                                            <select class="form-control not-chosen"
                                                                                    id="zender-ai-model"
                                                                                    name="active_model"
                                                                                    data-zender-ai-native-model="1"
                                                                                    required>
                                                                                {% if ai_settings.active_model %}
                                                                                    <option value="{{ ai_settings.active_model }}" selected>{{ ai_settings.active_model }}</option>
                                                                                {% else %}
                                                                                    <option value="">{{ 'mautic.zender.ai.settings.model_placeholder'|trans }}</option>
                                                                                {% endif %}
                                                                            </select>
                                                                            <span class="input-group-btn">
                                                                                <button type="button" class="btn btn-default" id="zender-ai-load-models">
                                                                                    {{ 'mautic.zender.ai.settings.load_models'|trans }}
                                                                                </button>
                                                                            </span>
                                                                        </div>
                                                                        <div class="help-block" id="zender-ai-model-status"></div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            {% set providerKeys = {
                                                                openai: 'OpenAI',
                                                                anthropic: 'Claude / Anthropic',
                                                                grok: 'Grok / xAI'
                                                            } %}

                                                            <div class="row">
                                                                {% for providerKey, providerLabel in providerKeys %}
                                                                    <div class="col-md-4">
                                                                        <div class="form-group">
                                                                            <label for="zender-ai-key-{{ providerKey }}">{{ providerLabel }} API key</label>
                                                                            <input type="password"
                                                                                   class="form-control"
                                                                                   id="zender-ai-key-{{ providerKey }}"
                                                                                   name="{{ providerKey }}_api_key"
                                                                                   autocomplete="off"
                                                                                   data-lpignore="true"
                                                                                   data-1p-ignore="true"
                                                                                   data-bwignore="true"
                                                                                   placeholder="{% if attribute(ai_settings.configured, providerKey) %}{{ 'mautic.zender.ai.settings.key_configured'|trans }}{% else %}{{ 'mautic.zender.ai.settings.key_missing'|trans }}{% endif %}">
                                                                            <div class="help-block">
                                                                                {% if attribute(ai_settings.configured, providerKey) %}
                                                                                    <span class="text-success">{{ 'mautic.zender.ai.settings.configured'|trans }}</span>
                                                                                {% else %}
                                                                                    {{ 'mautic.zender.ai.settings.not_configured'|trans }}
                                                                                {% endif %}
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                {% endfor %}
                                                            </div>

                                                            <button type="submit"
                                                                    class="btn btn-primary"
                                                                    id="zender-ai-settings-save">
                                                                {{ 'mautic.zender.ai.settings.save'|trans }}
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                            </div>
                        </div>
                        <aside class="zcs-guide-card" aria-label="{{ 'mautic.zender.settings.section.ai.guide_title'|trans }}">
                            <h3 class="zcs-guide-title">{{ 'mautic.zender.settings.section.ai.guide_title'|trans }}</h3>
                            <p class="zcs-guide-body">{{ 'mautic.zender.settings.section.ai.guide_body'|trans }}</p>
                            <ul class="zcs-guide-list">
                                <li>{{ 'mautic.zender.settings.section.ai.guide_1'|trans }}</li>
                                <li>{{ 'mautic.zender.settings.section.ai.guide_2'|trans }}</li>
                                <li>{{ 'mautic.zender.settings.section.ai.guide_3'|trans }}</li>
                            </ul>
                        </aside>
                    </section>

                    <div class="zcs-section-divider" aria-hidden="true"></div>

                    <section class="zcs-config-section" id="zender-settings-section-dispatch">
                        <div class="zcs-section-main">
                            <div class="zcs-section-heading">
                                <span class="zcs-section-kicker">{{ 'mautic.zender.settings.section.dispatch.kicker'|trans }}</span>
                                <h2 class="zcs-section-title">{{ 'mautic.zender.settings.section.dispatch.title'|trans }}</h2>
                                <p class="zcs-section-subtitle">{{ 'mautic.zender.settings.section.dispatch.subtitle'|trans }}</p>
                            </div>
                            <div class="zcs-section-content">
                                <form id="zender-settings-stage-3-interval-save"
                                                                  method="post"
                                                                  action="{{ path('mautic_zender_control_index') }}"
                                                                  data-window-seconds="{{ zenderWindowSeconds }}"
                                                                  data-enabled-accounts="{{ dashboard.accounts_enabled }}"
                                                                  data-zender-settings-stage="3-interval-save"
                                                                  class="zcs-card">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('mautic_zender_settings') }}">
                                                                <input type="hidden" name="settings_action" value="interval_only">

                                                                <div class="zcs-card-header">
                                                                    <div>
                                                                        <h3 class="zcs-card-title">{{ 'mautic.zender.settings.interval.title'|trans }}</h3>
                                                                        <p class="zcs-card-subtitle">{{ 'mautic.zender.settings.interval.info'|trans }}</p>
                                                                    </div>
                                                                    {% if app.request.query.get('settings_saved') == 'interval' %}
                                                                        <span class="zcs-chip">{{ 'mautic.zender.settings.interval.saved'|trans }}</span>
                                                                    {% endif %}
                                                                </div>

                                                                <div class="alert alert-info zcs-alert">
                                                                    {{ 'mautic.zender.settings.interval.current_window'|trans({
                                                                        '%start%': dashboard.config.window_start,
                                                                        '%end%': dashboard.config.window_end,
                                                                        '%count%': dashboard.accounts_enabled
                                                                    }) }}
                                                                </div>

                                                                <div class="form-group zcs-range">
                                                                    <label for="zender-settings-interval-preview">
                                                                        {{ 'mautic.zender.settings.interval.label'|trans }}
                                                                    </label>
                                                                    <input type="range"
                                                                           class="form-control"
                                                                           id="zender-settings-interval-preview"
                                                                           name="dispatch_interval_seconds"
                                                                           min="0"
                                                                           max="600"
                                                                           step="1"
                                                                           value="{{ zenderPreviewInterval }}"
                                                                           aria-describedby="zender-settings-interval-help"
                                                                           oninput="
                                                                               var panel = this.closest('[data-zender-settings-stage]');
                                                                               var parsedInterval = parseInt(this.value, 10);
                                                                               var interval = isNaN(parsedInterval) ? 0 : Math.max(0, parsedInterval);
                                                                               var windowSeconds = parseInt(panel.getAttribute('data-window-seconds'), 10) || 0;
                                                                               var devices = parseInt(panel.getAttribute('data-enabled-accounts'), 10) || 0;
                                                                               var perDevice = Math.floor(windowSeconds / Math.max(1, interval));
                                                                               panel.querySelector('[data-interval-seconds]').textContent = interval;
                                                                               panel.querySelector('[data-capacity-per-device]').textContent = perDevice;
                                                                               panel.querySelector('[data-capacity-total]').textContent = perDevice * devices;
                                                                           ">
                                                                    <p id="zender-settings-interval-help" class="help-block zcs-inline-help">
                                                                        {{ 'mautic.zender.settings.interval.selected_prefix'|trans }}
                                                                        <strong data-interval-seconds>{{ zenderPreviewInterval }}</strong>
                                                                        {{ 'mautic.zender.settings.seconds'|trans }}
